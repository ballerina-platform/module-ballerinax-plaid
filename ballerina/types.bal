public type BaseReportInvestments record {
    # Quantities and values of securities held in the investment account. Map to the `securities` array for security details.
    BaseReportInvestmentHolding[] holdings;
    # Details of specific securities held in the investment account.
    BaseReportInvestmentSecurity[] securities;
    # Transaction history on the investment account.
    BaseReportInvestmentTransaction[] investment_transactions;
};

# Defines the response schema for `/bank_transfer/cancel`
public type BankTransferCancelResponse record {
    # A unique identifier for the request, which can be used for troubleshooting. This identifier, like all Plaid identifiers, is case sensitive
    RequestID request_id;
};

# The error code of a failed transaction. Error codes include:
# 
# `EXTERNAL_SYSTEM`: The transaction was declined by an external system.
# 
# `EXPIRED`: The transaction request has expired.
# 
# `CANCELLED`: The transaction request was rescinded.
# 
# `INVALID`: The transaction did not meet certain criteria, such as an inactive account or no valid counterparty, etc.
# 
# `ACCOUNT_INVALID`: The transaction could not be processed because the wallet account is invalid or inactive.
# 
# `AUTHENTICATION_FAILED`: The transaction could not be processed because authentication with the wallet provider failed.
# 
# `UNKNOWN`: The transaction was unsuccessful, but the exact cause is unknown
public type WalletTransactionFailureReason "EXTERNAL_SYSTEM"|"EXPIRED"|"CANCELLED"|"INVALID"|"ACCOUNT_INVALID"|"AUTHENTICATION_FAILED"|"UNKNOWN"?;

# A client-provided transaction for Plaid to enhance
public type ClientProvidedRawTransaction record {
    # A unique ID for the transaction used to help you tie data back to your systems.
    string id;
    # The raw description of the transaction.
    string description;
    # The value of the transaction with direction. (NOTE: this will affect enrichment results, so directions are important).
    #   Negative (-) for credits (e.g., incoming transfers, refunds)
    #   Positive (+) for debits (e.g., purchases, fees, outgoing transfers)
    decimal amount;
    # The ISO-4217 currency code of the transaction e.g. USD.
    string iso_currency_code;
};

# A transaction on the Base Report
public type BaseReportTransaction record {
    # The ID of the account in which this transaction occurred.
    string account_id;
    # The settled value of the transaction, denominated in the transaction's currency, as stated in `iso_currency_code` or `unofficial_currency_code`. Positive values when money moves out of the account; negative values when money moves in. For example, debit card purchases are positive; credit card payments, direct deposits, and refunds are negative.
    decimal amount;
    # The ISO-4217 currency code of the transaction. Always `null` if `unofficial_currency_code` is non-null.
    string? iso_currency_code;
    # The unofficial currency code associated with the transaction. Always `null` if `iso_currency_code` is non-`null`. Unofficial currency codes are used for currencies that do not have official ISO currency codes, such as cryptocurrencies and the currencies of certain countries.
    # 
    # See the [currency code schema](https://plaid.com/docs/api/accounts#currency-code-schema) for a full listing of supported `unofficial_currency_code`s.
    string? unofficial_currency_code;
    # The merchant name or transaction description.
    # 
    # Note: This is a legacy field that is not actively maintained. Use `merchant_name` instead for the merchant name.
    # 
    # # Deprecated
    @deprecated
    string? name?;
    # The string returned by the financial institution to describe the transaction.
    string? original_description;
    # Information describing the intent of the transaction. Most relevant for credit use cases, but not limited to such use cases.
    # 
    # See the [`taxonomy csv file`](https://plaid.com/documents/credit-category-taxonomy.csv) for a full list of credit categories
    CreditCategory? credit_category?;
    # The check number of the transaction. This field is only populated for check transactions.
    string? check_number?;
    # For pending transactions, the date that the transaction occurred; for posted transactions, the date that the transaction posted. Both dates are returned in an [ISO 8601](https://wikipedia.org/wiki/ISO_8601) format ( `YYYY-MM-DD` ).
    string date;
    # The date on which the transaction took place, in ISO 8601 format.
    string? date_transacted?;
    # A representation of where a transaction took place. Location data is provided only for transactions at physical locations, not for online transactions. Location data availability depends primarily on the merchant and is most likely to be populated for transactions at large retail chains; small, local businesses are less likely to have location data available
    Location location?;
    # The merchant name, as enriched by Plaid from the `name` field. This is typically a more human-readable version of the merchant counterparty in the transaction. For some bank transactions (such as checks or account transfers) where there is no meaningful merchant name, this value will be `null`.
    string? merchant_name?;
    # When `true`, identifies the transaction as pending or unsettled. Pending transaction details (name, type, amount, category ID) may change before they are settled.
    boolean pending;
    # The name of the account owner. This field is not typically populated and only relevant when dealing with sub-accounts.
    string? account_owner?;
    # The unique ID of the transaction. Like all Plaid identifiers, the `transaction_id` is case sensitive.
    string transaction_id;
    # `digital:` transactions that took place online.
    # 
    # `place:` transactions that were made at a physical location.
    # 
    # `special:` transactions that relate to banks, e.g. fees or deposits.
    # 
    # `unresolved:` transactions that do not fit into the other types
    BaseReportTransactionType? transaction_type?;
    # A hierarchical array of the categories to which this transaction belongs. For a full list of categories, see [`/categories/get`](https://plaid.com/docs/api/products/transactions/#categoriesget).
    string[]? category?;
    # The ID of the category to which this transaction belongs. For a full list of categories, see [`/categories/get`](https://plaid.com/docs/api/products/transactions/#categoriesget).
    string? category_id?;
    # Information describing the intent of the transaction. Most relevant for personal finance use cases, but not limited to such use cases.
    # 
    # See the [taxonomy CSV file](https://plaid.com/documents/pfc-taxonomy-all.csv) for a full list of personal finance categories. If you are migrating to personal finance categories from the legacy categories, also refer to the [migration guide](https://plaid.com/docs/transactions/pfc-migration/)
    PersonalFinanceCategory? personal_finance_category?;
};

# An optional object to be used with the request
public type TransactionsEnrichRequestOptions record {
    # Include `legacy_category` and `legacy_category_id` in the response (in addition to the default `personal_finance_category`).
    # 
    # Categories are based on Plaid's legacy taxonomy. For a full list of legacy categories, see [`/categories/get`](https://plaid.com/docs/api/products/transactions/#categoriesget)
    @jsondata:Name {value: "include_legacy_category"}
    boolean includeLegacyCategory = false;
    # Indicates which version of the personal finance category taxonomy is being used. [View PFCv2 and PFCv1 taxonomies](https://plaid.com/documents/pfc-taxonomy-all.csv).
    # 
    # If you enabled Transactions or Enrich before December 3, 2025 you will receive the `v1` taxonomy by default and may request `v2` by explicitly setting this field to `v2` in the request.
    # 
    # If you enabled Transactions or Enrich on or after December 3, 2025, you may only receive the `v2` taxonomy
    @jsondata:Name {value: "personal_finance_category_version"}
    PersonalFinanceCategoryVersion personalFinanceCategoryVersion?;
};

# A signed amount of how much was `swept` or `return_swept` for this transfer (decimal string with two digits of precision e.g. "-5.50")
public type TransferSweepAmount string?;

# Score found by matching phone number provided by the API with the phone number on the account at the financial institution. 100 is a perfect match and 0 is a no match. If the account contains multiple owners, the maximum match score is filled
public type PhoneNumberMatchScore record {
    # Match score for normalized phone number. 100 is a perfect match, 99-70 is a partial match (matching the same phone number with extension against one without extension, etc.), anything below 70 is considered a mismatch. Typically, the match threshold should be set to a score of 70 or higher. If the phone number is missing from either the API or financial institution, this is null.
    int? score;
};

# CraServicingSubscriptionCreateResponse defines the response schema for `/cra/servicing/subscription/create`
public type CraServicingSubscriptionCreateResponse record {
    # A CRA servicing subscription identifier, in the format `cra-sub-<environment>-<uuid>`
    CraSubscriptionID subscription_id;
    # A unique identifier for the request, which can be used for troubleshooting. This identifier, like all Plaid identifiers, is case sensitive
    RequestID request_id;
};

# CashflowReportInsightsGetResponse defines the response schema for `/cashflow_report/insights/get`
public type CashflowReportInsightsGetResponse record {
    # Metadata about the Item
    Item item;
    # An array containing the `accounts` associated with the Item for which transactions are being returned. Each transaction can be mapped to its corresponding account via the `account_id` field.
    BusinessAccount[] accounts;
    # Insights on the account level. These are only returned for Credit and Depository type accounts
    CashflowReportAccountInsights account_insights;
    # Datetime of last Cashflow Report generation in [ISO 8601](https://wikipedia.org/wiki/ISO_8601) format ( `YYYY-MM-DDTHH:mm:ssZ` )
    string last_generated_time;
    # A unique identifier for the request, which can be used for troubleshooting. This identifier, like all Plaid identifiers, is case sensitive
    RequestID request_id;
};

# The version of Network Insights. Required if using Network Insights
public type NetworkInsightsVersion "NI1"?;

# The version of Prism CashScore. If not specified, will default to v3
public type PrismCashScoreVersion "4.1"|"4"|"3_lite"|"3"?;

# A random key provided by the client, per unique refund. Maximum of 50 characters.
# 
# The API supports idempotency for safely retrying requests without accidentally performing the same operation twice. For example, if a request to create a refund fails due to a network connection error, you can retry the request with the same idempotency key to guarantee that only a single refund is created
@constraint:String {maxLength: 50}
public type TransferRefundIdempotencyKey string;

# ItemApplicationUnlinkRequest defines the request schema for `/item/application/unlink`
public type ItemApplicationUnlinkRequest record {
    # The access token associated with the Item for which data is being requested
    @jsondata:Name {value: "access_token"}
    AccessToken accessToken;
    # Your Plaid API `secret`. The `secret` is required and may be provided either in the `PLAID-SECRET` header or as part of a request body
    APISecret secret?;
    # This field will map to the application ID that is returned from `/item/application/list`, or provided to the institution in an oauth redirect
    @jsondata:Name {value: "application_id"}
    ApplicationID applicationId;
    # Your Plaid API `client_id`. The `client_id` is required and may be provided either in the `PLAID-CLIENT-ID` header or as part of a request body
    @jsondata:Name {value: "client_id"}
    APIClientID clientId?;
};

# Data about the components comprising an address
public type AddressData record {
    # The full city name
    string? city;
    # The region or state. In API versions 2018-05-22 and earlier, this field is called `state`.
    # Example: `"NC"`
    string? region;
    # The full street address
    # Example: `"564 Main Street, APT 15"`
    string street;
    # The postal code. In API versions 2018-05-22 and earlier, this field is called `zip`.
    string? postal_code;
    # The ISO 3166-1 alpha-2 country code
    string? country;
};

# Object representing fraud risk data of the uploaded document. Only provided when using Identity Document Upload with Fraud Risk enabled
public type IdentityDocumentUploadRiskInsights record {
    # Risk summary of an uploaded document
    IdentityDocumentUploadRiskSummary risk_summary?;
    # An array of risk signals.
    IdentityDocumentUploadRiskSignal[] risk_signals?;
};

# A single entry in the adaptive guarantee settlement schedule, describing one tranche of guaranteed funds. Adds `observation_window_expiration_time`, which is only known once a transfer is created
public type TransferGuaranteeScheduleItem record {
    *AuthorizationGuaranteeScheduleItem;
    # The datetime when the observation window for this tranche expires. Present only when the tranche is subject to an observation window. This will be of the form `2006-01-02T15:04:05Z`.
    string? observation_window_expiration_time?;
};

# FDX Participant - an entity or person that is a part of a FDX API transaction
public type FDXParty record {
    # The registry containing the party's registration with name and id
    FDXPartyRegistry registry?;
    # Human recognizable common name
    string name;
    # Registered name of party
    string registeredEntityName?;
    # URI for a logo asset to be displayed to the end user
    string logoUri?;
    # Identifies the type of a party
    FDXPartyType 'type;
    # URI for party, where an end user could learn more about the company or application involved in the data sharing chain
    string homeUri?;
    # Registered id of party
    string registeredEntityId?;
};

# Request input for listing Beacon Reports
public type BeaconReportListRequest record {
    # An identifier that determines which page of results you receive
    Cursor? cursor?;
    # ID of the associated Beacon User
    @jsondata:Name {value: "beacon_user_id"}
    BeaconUserID beaconUserId;
    # Your Plaid API `secret`. The `secret` is required and may be provided either in the `PLAID-SECRET` header or as part of a request body
    APISecret secret?;
    # Your Plaid API `client_id`. The `client_id` is required and may be provided either in the `PLAID-CLIENT-ID` header or as part of a request body
    @jsondata:Name {value: "client_id"}
    APIClientID clientId?;
};

# The verification refresh status. One of the following:
# 
# `"USER_PRESENCE_REQUIRED"` User presence is required to refresh an income verification.
# 
# `"SUCCESSFUL"` The income verification refresh was successful.
# 
# `"NOT_FOUND"` No new data was found after the income verification refresh
public type CreditPayrollIncomeRefreshStatus string;

# CreditBankEmploymentGetRequest defines the request schema for `/beta/credit/v1/bank_employment/get`
public type CreditBankEmploymentGetRequest record {
    # Your Plaid API `secret`. The `secret` is required and may be provided either in the `PLAID-SECRET` header or as part of a request body
    APISecret secret?;
    # The user token associated with the user for which data is being requested. This field is used only by customers with pre-existing integrations that already use the `user_token` field. All other customers should use the `user_id` instead. For more details, see [New User APIs](https://plaid.com/docs/api/users/user-apis)
    @jsondata:Name {value: "user_token"}
    UserToken userToken;
    # Your Plaid API `client_id`. The `client_id` is required and may be provided either in the `PLAID-CLIENT-ID` header or as part of a request body
    @jsondata:Name {value: "client_id"}
    APIClientID clientId?;
};

# Defines the request schema for `/bank_transfer/list`
public type BankTransferListRequest record {
    # The end datetime of bank transfers to list. This should be in RFC 3339 format (i.e. `2019-12-06T22:35:49Z`)
    @jsondata:Name {value: "end_date"}
    string? endDate?;
    # The number of bank transfers to skip before returning results
    @constraint:Int {minValue: 0}
    int offset = 0;
    # The maximum number of bank transfers to return
    @constraint:Int {minValue: 1, maxValue: 25}
    int count = 25;
    # Filter bank transfers to only those originated through the specified origination account
    @jsondata:Name {value: "origination_account_id"}
    string? originationAccountId?;
    # Your Plaid API `secret`. The `secret` is required and may be provided either in the `PLAID-SECRET` header or as part of a request body
    APISecret secret?;
    # Your Plaid API `client_id`. The `client_id` is required and may be provided either in the `PLAID-CLIENT-ID` header or as part of a request body
    @jsondata:Name {value: "client_id"}
    APIClientID clientId?;
    # The start datetime of bank transfers to list. This should be in RFC 3339 format (i.e. `2019-12-06T22:35:49Z`)
    @jsondata:Name {value: "start_date"}
    string? startDate?;
    # Indicates the direction of the transfer: `outbound` for API-initiated transfers, or `inbound` for payments received by the FBO account
    BankTransferDirection? direction?;
};

# AccountsBalanceGetRequest defines the request schema for `/accounts/balance/get`
public type AccountsBalanceGetRequest record {
    # The access token associated with the Item for which data is being requested
    @jsondata:Name {value: "access_token"}
    AccessToken accessToken;
    # Optional parameters to `/accounts/balance/get`
    AccountsBalanceGetRequestOptions options?;
    # Your Plaid API `secret`. The `secret` is required and may be provided either in the `PLAID-SECRET` header or as part of a request body
    APISecret secret?;
    # Your Plaid API `client_id`. The `client_id` is required and may be provided either in the `PLAID-CLIENT-ID` header or as part of a request body
    @jsondata:Name {value: "client_id"}
    APIClientID clientId?;
};

# A comment submitted by a team member as part of reviewing a watchlist screening
public type ReviewComment string?;

# A Beacon Report Syndication represents a Beacon Report created either by your organization or another Beacon customer that matches a specific Beacon User you've created.
# 
# The `analysis` field in the response indicates which fields matched between the originally reported Beacon User and the Beacon User that the report was syndicated to.
# 
# The `report` field in the response contains a subset of information from the original report
public type BeaconReportSyndication record {
    # ID of the associated Beacon Report Syndication
    BeaconReportSyndicationID id;
    # ID of the associated Beacon User
    BeaconUserID beacon_user_id;
    # A subset of information from a Beacon Report that has been syndicated to a matching Beacon User in your program.
    # 
    # The `id` field in the response is the ID of the original report that was syndicated. If the original report was created by your organization, the field will be filled with the ID of the report. Otherwise, the field will be `null` indicating that the original report was created by another Beacon customer
    BeaconReportSyndicationOriginalReport report;
    # Analysis of which fields matched between the originally reported Beacon User and the Beacon User that the report was syndicated to
    BeaconReportSyndicationAnalysis analysis;
};

# Type of entity causing origination of a notification
public type FDXNotificationPayloadIdType "ACCOUNT"|"CUSTOMER"|"PARTY"|"MAINTENANCE"|"CONSENT";

# The error returned by Prism for this product
public type PrismErrorReason string;

# CraCheckReportCreateRequest defines the request schema for `/cra/check_report/create`
public type CraCheckReportCreateRequest record {
    # The destination URL to which webhooks will be sent
    string webhook;
    # Defines configuration options to generate the LendScore
    @jsondata:Name {value: "lend_score"}
    CraCheckReportCreateLendScoreOptions? lendScore?;
    # Indicates that investment data should be extracted from the linked account(s)
    @jsondata:Name {value: "include_investments"}
    boolean? includeInvestments?;
    # Your Plaid API `secret`. The `secret` is required and may be provided either in the `PLAID-SECRET` header or as part of a request body
    APISecret secret?;
    # Defines configuration options to generate Income Insights
    @jsondata:Name {value: "income_insights"}
    CraCheckReportCreateIncomeInsightsOptions? incomeInsights?;
    # Defines configuration to generate Partner Insights
    @jsondata:Name {value: "partner_insights"}
    CraCheckReportCreatePartnerInsightsOptions? partnerInsights?;
    # The minimum number of days of data required for the report to be successfully generated
    @jsondata:Name {value: "days_required"}
    int daysRequired?;
    # Describes the reason you are generating a Consumer Report for this user. When calling `/link/token/create`, this field is required when using Plaid Check (CRA) products; invalid if not using Plaid Check (CRA) products.
    # 
    # `ACCOUNT_REVIEW_CREDIT`: In connection with a consumer credit transaction for the review or collection of an account pursuant to FCRA Section 604(a)(3)(A).
    # 
    # `ACCOUNT_REVIEW_NON_CREDIT`: For a legitimate business need of the information to review a non-credit account provided primarily for personal, family, or household purposes to determine whether the consumer continues to meet the terms of the account pursuant to FCRA Section 604(a)(3)(F)(2).
    # 
    # `EXTENSION_OF_CREDIT`: In connection with a credit transaction initiated by and involving the consumer pursuant to FCRA Section 604(a)(3)(A).
    # 
    # `LEGITIMATE_BUSINESS_NEED_TENANT_SCREENING`: For a legitimate business need in connection with a business transaction initiated by the consumer primarily for personal, family, or household purposes in connection with a property rental assessment pursuant to FCRA Section 604(a)(3)(F)(i).
    # 
    # `LEGITIMATE_BUSINESS_NEED_OTHER`: For a legitimate business need in connection with a business transaction made primarily for personal, family, or household initiated by the consumer pursuant to FCRA Section 604(a)(3)(F)(i).
    # 
    # `WRITTEN_INSTRUCTION_PREQUALIFICATION`: In accordance with the written instructions of the consumer pursuant to FCRA Section 604(a)(2), to evaluate an application's profile to make an offer to the consumer.
    # 
    # `WRITTEN_INSTRUCTION_OTHER`: In accordance with the written instructions of the consumer pursuant to FCRA Section 604(a)(2), such as when an individual agrees to act as a guarantor or assumes personal liability for a consumer, business, or commercial loan.
    # 
    # `ELIGIBILITY_FOR_GOVT_BENEFITS`:  In connection with an eligibility determination for a government benefit where the entity is required to consider an applicant's financial status pursuant to FCRA Section 604(a)(3)(D)
    @jsondata:Name {value: "consumer_report_permissible_purpose"}
    ConsumerReportPermissiblePurpose consumerReportPermissiblePurpose;
    # Your Plaid API `client_id`. The `client_id` is required and may be provided either in the `PLAID-CLIENT-ID` header or as part of a request body
    @jsondata:Name {value: "client_id"}
    APIClientID clientId?;
    # Defines configuration options to generate Cashflow Insights
    @jsondata:Name {value: "cashflow_insights"}
    CraCheckReportCreateCashflowInsightsOptions? cashflowInsights?;
    # Specifies a list of products to generate when creating the report (in addition to the Base Report, which is always generated). These products will be made available before a success webhook is sent. Note that specifying `cra_partner_insights` in this field will trigger a billable event. Other products are not billed until the respective reports are retrieved via their product-specific `/get` endpoints
    Products[]? products?;
    # Defines configuration options to generate a Base Report
    @jsondata:Name {value: "base_report"}
    CraCheckReportCreateBaseReportOptions? baseReport?;
    # A unique user identifier, created by `/user/create`. Integrations that began using `/user/create` after December 10, 2025 use this field to identify a user instead of the `user_token`. For more details, see [New User APIs](https://plaid.com/docs/api/users/user-apis)
    @jsondata:Name {value: "user_id"}
    NewUserID userId?;
    # Defines configuration options to generate Network Insights
    @jsondata:Name {value: "network_insights"}
    CraCheckReportCreateNetworkInsightsOptions? networkInsights?;
    # Client-generated identifier, which can be used by lenders to track loan applications
    @jsondata:Name {value: "client_report_id"}
    string? clientReportId?;
    # The user token associated with the user for which data is being requested. This field is used only by customers with pre-existing integrations that already use the `user_token` field. All other customers should use the `user_id` instead. For more details, see [New User APIs](https://plaid.com/docs/api/users/user-apis)
    @jsondata:Name {value: "user_token"}
    UserToken userToken?;
    # The number of days of data to request for the report. Default value is 365; maximum is 731; minimum is 180. If a value lower than 180 is provided, a minimum of 180 days of history will be requested
    @jsondata:Name {value: "days_requested"}
    int daysRequested;
};

# Shorthand identifier for a specific screening list for individuals.
# 
#  `AU_CON`: Australia Department of Foreign Affairs and Trade Consolidated List
# 
#  `CA_CON`: Government of Canada Consolidated List of Sanctions
# 
#  `EU_CON`: European External Action Service Consolidated List
# 
#  `IZ_CIA`: CIA List of Chiefs of State and Cabinet Members
# 
#  `IZ_IPL`: Interpol Red Notices for Wanted Persons List
# 
#  `IZ_PEP`: Politically Exposed Persons List
# 
#  `IZ_UNC`: United Nations Consolidated Sanctions
# 
#  `IZ_WBK`: World Bank Listing of Ineligible Firms and Individuals
# 
#  `UK_HMC`: Foreign, Commonwealth & Development Office UK Sanctions List
# 
#  `US_DPL`: Bureau of Industry and Security Denied Persons List
# 
#  `US_DTC`: US Department of State AECA Debarred
# 
#  `US_FBI`: US Department of Justice FBI Wanted List
# 
#  `US_FSE`: US OFAC Foreign Sanctions Evaders
# 
#  `US_ISN`: US Department of State Nonproliferation Sanctions
# 
#  `US_MBS`: US Non-SDN Menu-Based Sanctions
# 
#  `US_PLC`: US OFAC Palestinian Legislative Council
# 
#  `US_SAM`: US System for Award Management Exclusion List
# 
#  `US_SDN`: US OFAC Specially Designated Nationals List
# 
#  `US_SSI`: US OFAC Sectoral Sanctions Identifications
# 
#  `SG_SOF`: Government of Singapore Terrorists and Terrorist Entities
# 
#  `TR_TWL`: Government of Turkey Terrorist Wanted List
# 
#  `TR_DFD`: Government of Turkey Domestic Freezing Decisions
# 
#  `TR_FOR`: Government of Turkey Foreign Freezing Requests
# 
#  `TR_WMD`: Government of Turkey Weapons of Mass Destruction
# 
#  `TR_CMB`: Government of Turkey Capital Markets Board
public type IndividualWatchlistCode "AU_CON"|"CA_CON"|"EU_CON"|"IZ_CIA"|"IZ_IPL"|"IZ_PEP"|"IZ_UNC"|"IZ_WBK"|"UK_HMC"|"US_DPL"|"US_DTC"|"US_FBI"|"US_FSE"|"US_ISN"|"US_MBS"|"US_PLC"|"US_SAM"|"US_SDN"|"US_SSI"|"SG_SOF"|"TR_TWL"|"TR_DFD"|"TR_FOR"|"TR_WMD"|"TR_CMB";

# Names the Home Lending product at a given version
public type CraHomeLendingProduct record {
    # The Home Lending product discriminator.
    "cra_home_lending" product;
    # A string that specifies a particular version of a CRA product
    CraProductVersion version;
};

# Indicator of account number format validity for institution.
# 
# `valid`: indicates that the account number has a correct format for the institution.
# 
# `invalid`: indicates that the account number has an incorrect format for the institution.
# 
# `unknown`: indicates that there was not enough information to determine whether the format is correct for the institution
public type AccountVerificationInsightsAccountNumberFormat "valid"|"invalid"|"unknown";

# Modeled current income for a given currency. Home Lending reports current income only; there is no projected income figure
public type CraReportGetHomeLendingIncomeMetrics record {
    # Modeled estimate of current income based on recently observed income transactions
    CraCurrentModeledIncome? current;
    # The ISO 4217 currency code of the amount or balance
    CreditIsoCurrencyCode? iso_currency_code;
    # The unofficial currency code associated with the amount or balance. Always `null` if `iso_currency_code` is non-null.
    # Unofficial currency codes are used for currencies that do not have official ISO currency codes, such as cryptocurrencies and the currencies of certain countries
    CreditUnofficialCurrencyCode? unofficial_currency_code;
};

# High level descriptions of how the associated document was processed. If a document fails verification, the details in the `analysis` object should help clarify why the document was rejected
public type DocumentAnalysis record {
    # High level summary of whether the document in the provided image matches the formatting rules and security checks for the associated jurisdiction.
    # 
    # For example, most identity documents have formatting rules like the following:
    # 
    # 
    # The image of the person's face must have a certain contrast in order to highlight skin tone
    # 
    # 
    # The subject in the document's image must remove eye glasses and pose in a certain way
    # 
    # 
    # The informational fields (name, date of birth, ID number, etc.) must be colored and aligned according to specific rules
    # 
    # 
    # Security features like watermarks and background patterns must be present
    # 
    # So a `match` status for this field indicates that the document in the provided image seems to conform to the various formatting and security rules associated with the detected document
    DocumentAuthenticityMatchCode authenticity;
    # A high level description of the quality of the image the user submitted.
    # 
    # For example, an image that is blurry, distorted by glare from a nearby light source, or improperly framed might be marked as low or medium quality. Poor quality images are more likely to fail OCR and/or template conformity checks.
    # 
    # Note: By default, Plaid will let a user recapture document images twice before failing the entire session if we attribute the failure to low image quality
    ImageQuality image_quality;
    # Analysis of the data extracted from the submitted document
    PhysicalDocumentExtractedDataAnalysis? extracted_data;
    # Details about the fraud analysis performed on the document
    FraudAnalysisDetails? fraud_analysis_details;
    # Details about the image quality of the document
    ImageQualityDetails? image_quality_details;
    # Details about the human review check, which refers to a check that is performed by a document specialist
    HumanReview? human_review?;
    # Analyzed AAMVA data for the associated hit.
    # 
