    @jsondata:Name {value: "application_url"}
    string? applicationUrl;
    # A string representing client's broad use case as assessed by Plaid
    @jsondata:Name {value: "use_case"}
    string? useCase;
    # A string representing the country code of the client's headquarters
    @jsondata:Name {value: "country_code"}
    string? countryCode;
    # A string representing the name of client's legal entity
    @jsondata:Name {value: "company_legal_name"}
    string? companyLegalName;
    # A string provided by the connected app stating why they use their respective enabled products
    @jsondata:Name {value: "reason_for_access"}
    string? reasonForAccess;
    # The name of the application
    string name;
    # A string representing the region of the client's headquarters
    string? region;
    # A string representing the postal code of the client's headquarters
    @jsondata:Name {value: "postal_code"}
    string? postalCode;
};

# A grouping of related transactions
public type TransactionStream record {
    # The ID of the account to which the stream belongs
    string account_id;
    # A unique id for the stream
    string stream_id;
    # A hierarchical array of the categories to which this transaction belongs. See [Categories](https://plaid.com/docs/api/products/transactions/#categoriesget).
    # 
    # All implementations are encouraged to use the new `personal_finance_category` instead of `category`. `personal_finance_category` provides more meaningful categorization and greater accuracy.
    # 
    # # Deprecated
    @deprecated
    string[]? category;
    # The ID of the category to which this transaction belongs. See [Categories](https://plaid.com/docs/api/products/transactions/#categoriesget).
    # 
    # All implementations are encouraged to use the new `personal_finance_category` instead of `category`. `personal_finance_category` provides more meaningful categorization and greater accuracy.
    # 
    # # Deprecated
    @deprecated
    string? category_id;
    # A description of the transaction stream.
    string description;
    # The merchant associated with the transaction stream.
    string? merchant_name;
    # The posted date of the earliest transaction in the stream.
    string first_date;
    # The posted date of the latest transaction in the stream.
    string last_date;
    # The predicted date of the next payment. This will only be set if the next payment date can be predicted.
    string? predicted_next_date?;
    # Describes the frequency of the transaction stream.
    # 
    # `WEEKLY`: Assigned to a transaction stream that occurs approximately every week.
    # 
    # `BIWEEKLY`: Assigned to a transaction stream that occurs approximately every 2 weeks.
    # 
    # `SEMI_MONTHLY`: Assigned to a transaction stream that occurs approximately twice per month. This frequency is typically seen for inflow transaction streams.
    # 
    # `MONTHLY`: Assigned to a transaction stream that occurs approximately every month.
    # 
    # `ANNUALLY`: Assigned to a transaction stream that occurs approximately every year.
    # 
    # `UNKNOWN`: Assigned to a transaction stream that does not fit any of the pre-defined frequencies
    RecurringTransactionFrequency frequency;
    # An array of Plaid transaction IDs belonging to the stream, sorted by posted date.
    string[] transaction_ids;
    # Object with data pertaining to an amount on the transaction stream
    TransactionStreamAmount average_amount;
    # Object with data pertaining to an amount on the transaction stream
    TransactionStreamAmount last_amount;
    # Indicates whether the transaction stream is still live.
    boolean is_active;
    # The current status of the transaction stream.
    # 
    # `MATURE`: A `MATURE` recurring stream should have at least 3 transactions and happen on a regular cadence (For Annual recurring stream, we will mark it `MATURE` after 2 instances).
    # 
    # `EARLY_DETECTION`: When a recurring transaction first appears in the transaction history and before it fulfills the requirement of a mature stream, the status will be `EARLY_DETECTION`.
    # 
    # `TOMBSTONED`: A stream that was previously in the `EARLY_DETECTION` status will move to the `TOMBSTONED` status when no further transactions were found at the next expected date.
    # 
    # `UNKNOWN`: A stream is assigned an `UNKNOWN` status when none of the other statuses are applicable
    TransactionStreamStatus status;
    # Information describing the intent of the transaction. Most relevant for personal finance use cases, but not limited to such use cases.
    # 
    # See the [taxonomy CSV file](https://plaid.com/documents/pfc-taxonomy-all.csv) for a full list of personal finance categories. If you are migrating to personal finance categories from the legacy categories, also refer to the [migration guide](https://plaid.com/docs/transactions/pfc-migration/)
    PersonalFinanceCategory? personal_finance_category?;
    # As the ability to modify transactions streams has been discontinued, this field will always be `false`.
    # 
    # # Deprecated
    @deprecated
    boolean is_user_modified;
    # The date and time of the most recent user modification. This will only be set if `is_user_modified` is `true`.
    # 
    # # Deprecated
    @deprecated
    string last_user_modified_datetime?;
};

# A business verification represents a check of a business's identity and risk profile, including information collected about the business and results from third-party data providers
public type BusinessVerificationGetResponse record {
    # ID of the associated business verification
    BusinessVerificationID id;
    # A unique ID that identifies the end user in your system. Either a `user_id` or the `client_user_id` must be provided. This ID can also be used to associate user-specific data from other Plaid products. Financial Account Matching requires this field and the `/link/token/create` `client_user_id` to be consistent. Personally identifiable information, such as an email address or phone number, should not be used in the `client_user_id`
    ClientUserID client_user_id;
    # An ISO8601 formatted timestamp
    Timestamp created_at;
    # An ISO8601 formatted timestamp
    TimestampNullable? completed_at;
    # An ISO8601 formatted timestamp
    TimestampNullable? redacted_at;
    # Status of the overall business verification
    BusinessVerificationStatusOverall status;
    # The business information that was used to perform the verification search
    BusinessSearchTerms search_terms;
    # Results from the KYB (Know Your Business) identity verification check
    BusinessKYBCheck? kyb_check;
    # Results from the business risk assessment check
    BusinessRiskCheck? risk_check;
    # Results from the digital presence check
    BusinessDigitalPresenceCheck? digital_presence_check;
    # A unique identifier for the request, which can be used for troubleshooting. This identifier, like all Plaid identifiers, is case sensitive
    RequestID request_id;
    # A shareable URL that can be sent directly to the user to complete verification
    BusinessVerificationShareableURL? shareable_url;
};

# Priority of notification
public type FDXNotificationPriority "HIGH"|"MEDIUM"|"LOW";

# ItemRemoveRequest defines the request schema for `/item/remove`
public type ItemRemoveRequest record {
    # The access token associated with the Item for which data is being requested
    @jsondata:Name {value: "access_token"}
    AccessToken accessToken;
    # The reason for removing the Item
    # 
    # `FRAUD_FIRST_PARTY`: The end user who owns the connected bank account committed fraud
    # 
    # `FRAUD_FALSE_IDENTITY`: The end user created the connection using false identity information or stolen credentials
    # 
    # `FRAUD_ABUSE`: The end user is abusing the client's service or platform through their connected account
    # 
    # `FRAUD_OTHER`: Other fraud-related reasons involving the end user not covered by the specific fraud categories
    # 
    # `CONNECTION_IS_NON_FUNCTIONAL`: The connection to the end user's financial institution is broken and cannot be restored
    # 
    # `OTHER`: Any other reason for removing the connection not covered by the above categories
    @jsondata:Name {value: "reason_code"}
    ItemRemoveReasonCode? reasonCode?;
    # Additional context or details about the reason for removing the Item. Personally identifiable information, such as an email address or phone number, should not be included in the `reason_note`
    @jsondata:Name {value: "reason_note"}
    string? reasonNote?;
    # Your Plaid API `secret`. The `secret` is required and may be provided either in the `PLAID-SECRET` header or as part of a request body
    APISecret secret?;
    # Your Plaid API `client_id`. The `client_id` is required and may be provided either in the `PLAID-CLIENT-ID` header or as part of a request body
    @jsondata:Name {value: "client_id"}
    APIClientID clientId?;
};

