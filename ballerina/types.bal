    @jsondata:Name {value: "item_ids"}
    string[] itemIds?;
};

# CraReportGetResponse defines the response schema for `/cra/report/get`
public type CraReportGetResponse record {
    # The CRA report returned by `/cra/report/get`
    CraReportGetReport report;
    # A unique identifier for the request, which can be used for troubleshooting. This identifier, like all Plaid identifiers, is case sensitive
    RequestID request_id;
    # A unique user identifier, created by `/user/create`. Integrations that began using `/user/create` after December 10, 2025 use this field to identify a user instead of the `user_token`. For more details, see [New User APIs](https://plaid.com/docs/api/users/user-apis)
    NewUserID user_id;
    # The unique ID representing the end user that you supplied as `client_user_id` when creating the user via `/user/create`. `null` if the user has no `client_user_id` on record.
    string? client_user_id?;
    # User or report-level errors that affected the overall report but do not map to a specific product failure.
    CheckReportWarning[] warnings;
};

