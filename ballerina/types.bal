# The communication method containing both the type and address to send the URL
public type LinkDeliveryCommunicationMethod record {
    # The phone number / email address that Hosted Link sessions are delivered to. Phone numbers must be in E.164 format
    string address?;
    # The delivery method to be used to deliver the Hosted Link session URL.
    # 
    # `SMS`: The URL will be delivered through SMS
    # 
    # `EMAIL`: The URL will be delivered through email
    LinkDeliveryDeliveryMethod method?;
};

# SignalScheduleRequest defines the request schema for `/signal/schedule`
public type SignalScheduleRequest record {
    # The access token associated with the Item for which data is being requested
    @jsondata:Name {value: "access_token"}
    AccessToken accessToken;
    # The transaction amount, in USD (e.g. `102.05`)
    decimal amount;
    # The Plaid `account_id` of the account that is the funding source for the proposed transaction. The `account_id` is returned in the `/accounts/get` endpoint as well as the [`onSuccess`](https://plaid.com/docs/link/ios/#link-ios-onsuccess-linkSuccess-metadata-accounts-id) callback metadata.
    # 
    # This will return an [`INVALID_ACCOUNT_ID`](https://plaid.com/docs/errors/invalid-input/#invalid_account_id) error if the account has been removed at the bank or if the `account_id` is no longer valid
    @jsondata:Name {value: "account_id"}
    string accountId;
    # The payment method specified in the `default_payment_method` field directly impacts the timing recommendations provided by the API for submitting the debit entry to your processor or ODFI. If unspecified, defaults to `STANDARD_ACH`.
    # 
    # `SAME_DAY_ACH`: Same Day ACH (as defined by Nacha). The API assumes the settlement will occur on the same business day if the `/signal/schedule` request is submitted by 6:00 PM UTC. Note: The actual cutoff time can vary depending on your payment processor or ODFI. Nacha has established three processing windows for Same Day ACH (Eastern Time): 10:30 AM, 2:45 PM, and 4:45 PM.
    # 
    # `STANDARD_ACH`: Standard ACH (as defined by Nacha), typically settled one to three business days after submission.
    # 
    # `MULTIPLE_PAYMENT_METHODS`: Indicates that there is no default debit rail or multiple payment methods are available, and the transaction could use any of them based on customer policy or availability
    @jsondata:Name {value: "default_payment_method"}
    SignalScheduleDefaultPaymentMethod defaultPaymentMethod?;
    # Your Plaid API `secret`. The `secret` is required and may be provided either in the `PLAID-SECRET` header or as part of a request body
    APISecret secret?;
    # The unique ID that you would like to use to refer to this transaction. For your convenience mapping your internal data, you could use your internal ID/identifier for this transaction. The max length for this field is 36 characters
    @jsondata:Name {value: "client_transaction_id"}
    string clientTransactionId;
    # Your Plaid API `client_id`. The `client_id` is required and may be provided either in the `PLAID-CLIENT-ID` header or as part of a request body
    @jsondata:Name {value: "client_id"}
    APIClientID clientId?;
};

# Defines the request schema for `/sandbox/transfer/ledger/simulate_available`
public type SandboxTransferLedgerSimulateAvailableRequest record {
    # Client ID of the end customer (i.e. the originator). Only applicable to Transfer for Platforms customers
    @jsondata:Name {value: "originator_client_id"}
    string? originatorClientId?;
    # The webhook URL to which a `TRANSFER_EVENTS_UPDATE` webhook should be sent
    string webhook?;
    # Your Plaid API `secret`. The `secret` is required and may be provided either in the `PLAID-SECRET` header or as part of a request body
    APISecret secret?;
    # Plaid's unique identifier for a test clock. If provided, only the pending balance that is due before the `virtual_time` on the test clock will be converted
    @jsondata:Name {value: "test_clock_id"}
    string? testClockId?;
    # Specify which ledger balance to simulate converting pending balance to available balance. If this field is left blank, this will default to the id of the default ledger balance
    @jsondata:Name {value: "ledger_id"}
    string? ledgerId?;
    # Your Plaid API `client_id`. The `client_id` is required and may be provided either in the `PLAID-CLIENT-ID` header or as part of a request body
    @jsondata:Name {value: "client_id"}
    APIClientID clientId?;
};

# Where the payment consent period should start.
# 
# If the institution is Monzo, only `CONSENT` alignments are supported.
# 
# `CALENDAR`: line up with a calendar.
# 
# `CONSENT`: on the date of consent creation
public type PaymentConsentPeriodicAlignment "CALENDAR"|"CONSENT";

# An outcome status for this specific document submission. Distinct from the overall `documentary_verification.status` that summarizes the verification outcome from one or more documents
public type DocumentStatus "success"|"failed"|"manually_approved";

# Account data corresponding to the Item from which Partner Insights were generated
public type CraPartnerInsightsItemAccount record {
    # Plaid's unique identifier for the account. This value will not change unless Plaid can't reconcile the account with the data returned by the financial institution. This may occur, for example, when the name of the account changes. If this happens a new `account_id` will be assigned to the account.
    # 
    # If an account with a specific `account_id` disappears instead of changing, the account is likely closed. Closed accounts are not returned by the Plaid API.
    # 
    # Like all Plaid identifiers, the `account_id` is case sensitive.
    string account_id?;
    # The last 2-4 alphanumeric characters of an account's official account number.
    # Note that the mask may be non-unique between an Item's accounts, and it may also not match the mask that the bank displays to the user.
    string? mask;
    # An object containing metadata about the extracted account
    CraPartnerInsightsItemAccountMetadata metadata;
    # The name of the account
    string name;
    # The official name of the bank account.
    string? official_name;
    # Valid account subtypes for depository accounts. For a list containing descriptions of each subtype, see [Account schemas](https://plaid.com/docs/api/accounts/#StandaloneAccountType-depository)
    DepositoryAccountSubtype subtype;
    # The account type. This will always be `depository`
    CreditBankIncomeAccountType 'type;
    # Data returned by the financial institution about the account owner or owners. Identity information is optional, so field may return an empty array.
    Owner[] owners;
};

# Status of a document for risk signal analysis
public type RiskSignalDocumentStatus "PROCESSING"|"PROCESSING_COMPLETE"|"PROCESSING_ERROR"|"PASSWORD_PROTECTED"|"VIRUS_DETECTED";

# Detailed information for the income source
public type CreditBankIncomeSource record {
    # Maximum of all dates within the specific income sources in the user's bank account for days requested by the client.
    # The date will be returned in an ISO 8601 format (YYYY-MM-DD)
    @jsondata:Name {value: "end_date"}
    string endDate?;
    # Plaid's unique identifier for the account
    @jsondata:Name {value: "account_id"}
    string accountId?;
    # Total amount of earnings in the user's bank account for the specific income source for days requested by the client
    @jsondata:Name {value: "total_amount"}
    decimal totalAmount?;
    # The most common name or original description for the underlying income transactions
    @jsondata:Name {value: "income_description"}
    string incomeDescription?;
    # Number of transactions for the income source within the start and end date
    @jsondata:Name {value: "transaction_count"}
    int transactionCount?;
    # A unique identifier for an income source
    @jsondata:Name {value: "income_source_id"}
    string incomeSourceId?;
    # The income pay frequency
    @jsondata:Name {value: "pay_frequency"}
    CreditBankIncomePayFrequency payFrequency?;
    # The income category.
    # 
    # `BANK_INTEREST`: Interest earned from a bank account.
    # 
    # `BENEFIT_OTHER`: Government benefits other than retirement, unemployment, child support, or disability. Currently used only in the UK, to represent benefits such as Cost of Living Payments.
    # 
    # `CASH`: Deprecated and used only for existing legacy implementations. Has been replaced by `CASH_DEPOSIT` and `TRANSFER_FROM_APPLICATION`.
    # 
    # `CASH_DEPOSIT`: A cash or check deposit.
    # 
    # `CHILD_SUPPORT`: Child support payments received.
    # 
    # `GIG_ECONOMY`: Income earned as a gig economy worker, e.g. driving for Uber, Lyft, Postmates, DoorDash, etc.
    # 
    # `LONG_TERM_DISABILITY`: Disability payments, including Social Security disability benefits.
    # 
    # `OTHER`: Income that could not be categorized as any other income category.
    # 
    # `MILITARY`: Veterans benefits. Income earned as salary for serving in the military (e.g. through DFAS) will be classified as `SALARY` rather than `MILITARY`.
    # 
    # `RENTAL`: Income earned from a rental property. Income may be identified as rental when the payment is received through a rental platform, e.g. Airbnb; rent paid directly by the tenant to the property owner (e.g. via cash, check, or ACH) will typically not be classified as rental income.
    # 
    # `RETIREMENT`: Payments from private retirement systems, pensions, and government retirement programs, including Social Security retirement benefits.
    # 
    # `SALARY`: Payment from an employer to an earner or other form of permanent employment.
    # 
    # `TAX_REFUND`: A tax refund.
    # 
    # `TRANSFER_FROM_APPLICATION`: Deposits from a money transfer app, such as Venmo, Cash App, or Zelle.
    # 
    # `UNEMPLOYMENT`: Unemployment benefits. In the UK, includes certain low-income benefits such as the Universal Credit
    @jsondata:Name {value: "income_category"}
    CreditBankIncomeCategory incomeCategory?;
    # List of historical summaries
    @jsondata:Name {value: "historical_summary"}
    CreditBankIncomeHistoricalSummary[] historicalSummary?;
    # Minimum of all dates within the specific income sources in the user's bank account for days requested by the client.
    # The date will be returned in an ISO 8601 format (YYYY-MM-DD)
    @jsondata:Name {value: "start_date"}
    string startDate?;
};

# Aggregated summary of all income streams for this user
public type CraVerificationIncomeUserSummary record {
    # List of a user's aggregated income metrics for each currency.
    CraVerificationIncomeMetrics[] income_metrics;
};

# A monetary amount with its associated currency information, supporting both official and unofficial currency codes
public type AmountWithCurrency record {
    # If the parent object represents a category of transactions, such as `total_amount`, `transfers_in`, `total_income`, etc. the `amount` represents the sum of all of the transactions in the group.
    # 
    # If the parent object is `cash_flow`, the `amount` represents the total value of all the inflows minus all the outflows across all the accounts in the report in the given time window.
    # 
    # If the parent object is `minimum_balance`, the `amount` represents the lowest balance of the account during the given time window.
    decimal? amount?;
    # The ISO-4217 currency code of the amount. Always `null` if `unofficial_currency_code` is non-`null`.
    string? iso_currency_code?;
    # The unofficial currency code associated with the amount. Always `null` if `iso_currency_code` is non-`null`.
    # 
    # See the [currency code schema](https://plaid.com/docs/api/accounts#currency-code-schema) for a full listing of supported `unofficial_currency_code`s.
    string? unofficial_currency_code?;
};

# Response schema for `/partner/customer/get`
public type PartnerCustomerGetResponse record {
    # The details for an end customer
    PartnerEndCustomer end_customer?;
    # A unique identifier for the request, which can be used for troubleshooting. This identifier, like all Plaid identifiers, is case sensitive
    RequestID request_id?;
};

# The status of the given Hosted Link session.
# 
# `CREATED`: The session is created but not yet accessed by the user
# 
# `OPENED`: The session is opened by the user but not yet completed
# 
# `EXITED`: The session has been exited by the user
# 
# `COMPLETED`: The session has been completed by the user
# 
# `EXPIRED`: The session has expired
public type LinkDeliverySessionStatus "CREATED"|"OPENED"|"EXITED"|"COMPLETED"|"EXPIRED";

