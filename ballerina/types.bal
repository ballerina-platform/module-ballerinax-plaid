# Request object for `/protect/cash_advance/decision/create`
public type ProtectCashAdvanceDecisionCreateRequest record {
    # The outcome of a cash-advance decision.
    # 
    # `APPROVED` - The cash-advance was approved.
    # 
    # `DECLINED` - The cash-advance was declined
    CashAdvanceDecisionOutcome decision;
    # The details of a cash-advance associated with the decision. Required when `is_taken` is `true`
    @jsondata:Name {value: "cash_advance"}
    CashAdvanceInfo? cashAdvance?;
    # Required when `is_taken` is `true`.
    # Indicates if this would be a user's first or repeat cash-advance.
    # 
    # `FIRST` - A user's first cash-advance.
    # 
    # `REPEAT` - A user has previously taken out a cash-advance
    @jsondata:Name {value: "advance_type"}
    CashAdvanceType advanceType?;
    # Whether the end user took the cash-advance. Required when `decision` is APPROVED. When `true`, `client_advance_id` and `cash_advance` are required
    @jsondata:Name {value: "is_taken"}
    boolean? isTaken?;
    # The time the decision was made, in ISO 8601 / RFC 3339 format (`YYYY-MM-DDTHH:mm:ssZ`)
    @jsondata:Name {value: "decision_time"}
    string decisionTime;
    # Your Plaid API `secret`. The `secret` is required and may be provided either in the `PLAID-SECRET` header or as part of a request body
    APISecret secret?;
    # Represents an end user for `/protect/compute` requests
    ProtectUser user;
    # Your unique identifier for a cash-advance. Required when `is_taken` is `true`. This should be the same identifier provided when recording a repayment
    @jsondata:Name {value: "client_advance_id"}
    string? clientAdvanceId?;
    # Your Plaid API `client_id`. The `client_id` is required and may be provided either in the `PLAID-CLIENT-ID` header or as part of a request body
    @jsondata:Name {value: "client_id"}
    APIClientID clientId?;
    # The number of cash-advances a user has previously taken
    @jsondata:Name {value: "previous_advance_count"}
    int? previousAdvanceCount?;
};

# The total amount of all loan payment transactions during this month
public type CashflowReportMonthlySummaryTotalLoanPayment record {
    # The unofficial currency code of the amount. Always `null` if `iso_currency_code` is non-`null`. Unofficial currency codes are used for currencies that do not have official ISO currency codes, such as cryptocurrencies and the currencies of certain countries
    @jsondata:Name {value: "unofficial_currency_code"}
    CashflowUnofficialCurrencyCode? unofficialCurrencyCode;
    # Value of amount with up to 2 decimal places
    decimal amount;
    # The ISO-4217 currency code of the amount. Always `null` if `unofficial_currency_code` is non-`null`
    @jsondata:Name {value: "iso_currency_code"}
    CashflowIsoCurrencyCode? isoCurrencyCode;
};

