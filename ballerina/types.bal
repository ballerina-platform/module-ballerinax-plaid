# Limitations that will be applied to payments initiated using the payment consent
public type PaymentInitiationConsentConstraints record {
    # A list of amount limitations per period of time
    @jsondata:Name {value: "periodic_amounts"}
    PaymentConsentPeriodicAmount[] periodicAmounts;
    # Maximum amount of a single payment initiated using the payment consent
    @jsondata:Name {value: "max_payment_amount"}
    PaymentConsentMaxPaymentAmount maxPaymentAmount;
    # Life span for the payment consent. After the `to` date the payment consent expires and can no longer be used for payment initiation
    @jsondata:Name {value: "valid_date_time"}
    PaymentConsentValidDateTime? validDateTime?;
};

# A random key provided by the client, per unique bank transfer. Maximum of 50 characters.
# 
# The API supports idempotency for safely retrying requests without accidentally performing the same operation twice. For example, if a request to create a bank transfer fails due to a network connection error, you can retry the request with the same idempotency key to guarantee that only a single bank transfer is created
@constraint:String {maxLength: 50}
public type BankTransferIdempotencyKey string;

# Details about the transaction result after evaluation by the requested Ruleset. If a `ruleset_key` is not provided, for customers who began using Signal Transaction Scores before October 15, 2025, by default, this field will be omitted. To learn more, see [Signal Rules](https://plaid.com/docs/signal/signal-rules/)
public type Ruleset record {
    # The key of the Ruleset used for this transaction.
    string ruleset_key?;
    # The result of the rule that was triggered for this transaction.
    # 
    # `ACCEPT`: Accept the transaction for processing.
    # 
    # `REROUTE`: Reroute the transaction to a different payment method, as this transaction is too risky.
    # 
    # `REVIEW`: Review the transaction before proceeding
    RuleResult result;
    # Rules are run in numerical order. The first rule with a logic match is triggered. These are the details of that rule
    RuleDetails? triggered_rule_details?;
    # The evaluated outcome for this transaction. This field is deprecated, use `result` or `triggered_rule_details.custom_action_key` instead.
    # 
    # # Deprecated
    @deprecated
    string outcome?;
};

# The data from the Insights product returned by Prism Data
public type PrismInsights record {
    # The version of Prism Data's insights model used. This field is deprecated in favor of `model_version`.
    # 
    # # Deprecated
    @deprecated
    int version;
    # The version of Prism Data's insights model used.
    string model_version?;
    # The Insights Result object is a map of cash flow attributes, where the key is a string, and the value is a float or string. For a full list of all ~2,000 attributes, contact your account manager. The attributes may vary depending on the Prism version used
    PrismInsightsResult result?;
    # The error returned by Prism for this product
    PrismErrorReason error_reason?;
};

# OAuth token introspect request
public type OAuthIntrospectRequest record {
    # Your Plaid API `secret`. The `secret` is required and may be provided either in the `PLAID-SECRET` header or as part of a request body as either `secret` or `client_secret`
    @jsondata:Name {value: "client_secret"}
    OauthAPISecret clientSecret?;
    # Your Plaid API `secret`. The `secret` is required and may be provided either in the `PLAID-SECRET` header or as part of a request body as either `secret` or `client_secret`
    OauthAPISecret secret?;
    # Your Plaid API `client_id`. The `client_id` is required and may be provided either in the `PLAID-CLIENT-ID` header or as part of a request body
    @jsondata:Name {value: "client_id"}
    APIClientID clientId?;
    # An OAuth token of any type (`refresh_token`, `access_token`, etc)
    OAuthAnyToken token;
};

# The details for an end customer
public type PartnerEndCustomer record {
    # The `client_id` of the end customer.
    string client_id?;
    # The company name associated with the end customer.
    string company_name?;
    # The status of the given end customer.
    # 
    # `UNDER_REVIEW`: The end customer has been created and enabled in the Sandbox environment. The end customer must be manually reviewed by the Plaid team before it can be enabled in Production, at which point its status will automatically transition to `PENDING_ENABLEMENT` or `DENIED`.
    # 
    # `PENDING_ENABLEMENT`: The end customer is ready to be fully enabled in the Production environment. Call the `/partner/customer/enable` endpoint to enable the end customer in full Production.
    # 
    # `ACTIVE`: The end customer has been fully enabled in all environments.
    # 
    # `DENIED`: The end customer has been created and enabled in the Sandbox environment, but it did not pass review by the Plaid team and therefore cannot be enabled for Production access. Talk to your account manager for more information
    PartnerEndCustomerStatus status?;
};

