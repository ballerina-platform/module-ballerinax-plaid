    # Documentation not found in the MISMO model viewer and not provided by Freddie Mac
    CreditFreddieMacVerificationOfAssetResponse VERIFICATION_OF_ASSET_RESPONSE;
};

# CashflowReportGetRequest defines the request schema for `/cashflow_report/get`
public type CashflowReportGetRequest record {
    # The access token associated with the Item for which data is being requested
    @jsondata:Name {value: "access_token"}
    AccessToken accessToken;
    # The cursor value represents the last update requested. Pass in the empty string "" in the first call
    string cursor?;
    # Number of transactions to fetch per call
    @constraint:Int {minValue: 1, maxValue: 500}
    int count = 100;
    # An optional object to be used with the request. If specified, `options` must not be `null`
    CashflowReportGetRequestOptions options?;
    # Your Plaid API `secret`. The `secret` is required and may be provided either in the `PLAID-SECRET` header or as part of a request body
    APISecret secret?;
    # Your Plaid API `client_id`. The `client_id` is required and may be provided either in the `PLAID-CLIENT-ID` header or as part of a request body
    @jsondata:Name {value: "client_id"}
    APIClientID clientId?;
    # Number of days to retrieve transactions data for (1 to 730)
    @jsondata:Name {value: "days_requested"}
    int daysRequested;
};

