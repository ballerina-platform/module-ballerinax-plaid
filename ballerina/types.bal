    LoanInterestRate? interest_rate;
    # The outstanding principal balance of the loan.
    decimal? principal_balance;
    # The original principal amount of the loan.
    decimal? origination_principal_amount;
    # The date on which the loan was originated, in ISO 8601 format (YYYY-MM-DD).
    string? origination_date;
    # The length of the loan term in months.
    int:Signed32? loan_term_months;
    # The date on which the loan is scheduled to be fully paid, in ISO 8601 format (YYYY-MM-DD).
    string? maturity_date;
    # The total number of payments scheduled for the loan.
    int:Signed32? payment_count;
    # The frequency at which payments are scheduled
    LoanPaymentFrequency? payment_frequency;
    # The amount of the next scheduled payment.
    decimal? next_payment_amount;
    # The due date of the next payment, in ISO 8601 format (YYYY-MM-DD).
    string? next_payment_due_date;
    # The amount of the most recent payment.
    decimal? last_payment_amount;
    # The date of the most recent payment, in ISO 8601 format (YYYY-MM-DD).
    string? last_payment_date;
    # The amount required to fully pay off the loan.
    decimal? payoff_amount;
    # The year-to-date interest paid on the loan.
    decimal? ytd_interest_paid;
    # The frequency at which interest is compounded
    LoanCompoundingPeriod? compounding_period;
};

# How an issue was considered resolved. `MANUAL_RESOLUTION` indicates Plaid's engineering team has reviewed the issue and mitigated its impact. Issues that are manually resolved may still have a small number of occurrences. `AUTOMATED_RESOLUTION` indicates the error has not recently occurred and was automatically closed
public type BetaIssuesV1IssueResolutionType "MANUAL_RESOLUTION"|"AUTOMATED_RESOLUTION";

# Transaction information specific to inter-bank transfers. If the transaction was not an inter-bank transfer, all fields will be `null`.
# 
# If the `transactions` object was returned by a Transactions endpoint such as `/transactions/sync` or `/transactions/get`, the `payment_meta` key will always appear, but no data elements are guaranteed. If the `transactions` object was returned by an Assets endpoint such as `/asset_report/get` or `/asset_report/pdf/get`, this field will only appear in an Asset Report with Insights
public type PaymentMeta record {
    # The transaction reference number supplied by the financial institution.
    string? reference_number;
    # The ACH PPD ID for the payer.
    string? ppd_id;
    # For transfers, the party that is receiving the transaction.
    string? payee;
    # The party initiating a wire transfer. Will be `null` if the transaction is not a wire transfer.
    string? by_order_of;
    # For transfers, the party that is paying the transaction.
    string? payer;
    # The type of transfer, e.g. 'ACH'
    string? payment_method;
    # The name of the payment processor
    string? payment_processor;
    # The payer-supplied description of the transfer.
    string? reason;
};

