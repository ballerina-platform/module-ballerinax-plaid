# The tier of the user
public type CraUserTier "free"|"paid"?;

# Summary of how a specific business field matched against data provider results
public type BusinessFieldMatchSummary record {
    # An enum indicating the match type between data provided by user and data checked against an external data source.
    # 
    # 
    # `match` indicates that the provided input data was a strong match against external data.
    # 
    # `partial_match` indicates the data approximately matched against external data. For example, "Knope" vs. "Knope-Wyatt" for last name.
    # 
    # `no_match` indicates that Plaid was able to perform a check against an external data source and it did not match the provided input data.
    # 
    # `no_data` indicates that Plaid was unable to find external data to compare against the provided input data.
    # 
    # `no_input` indicates that Plaid was unable to perform a check because no information was provided for this field by the end user
    MatchSummaryCode summary;
};

# Total amount of debit transactions into the account in the last 60 days. This field will be empty for non-depository accounts. This field only takes into account USD transactions from the account
public type TotalInflowAmount60d record {
    # Value of amount with up to 2 decimal places.
    decimal amount;
    # The ISO 4217 currency code of the amount or balance
    CreditIsoCurrencyCode? iso_currency_code;
    # The unofficial currency code associated with the amount or balance. Always `null` if `iso_currency_code` is non-null.
    # Unofficial currency codes are used for currencies that do not have official ISO currency codes, such as cryptocurrencies and the currencies of certain countries
    CreditUnofficialCurrencyCode? unofficial_currency_code;
};

# CreditRelayCreateRequest defines the request schema for `/credit/relay/create`
public type CreditRelayCreateRequest record {
    # List of report token strings, with at most one token of each report type. Currently only Asset Report token is supported
    @jsondata:Name {value: "report_tokens"}
    string[] reportTokens;
    # URL to which Plaid will send webhooks when the Secondary Client successfully retrieves an Asset Report by calling `/credit/relay/get`
    string? webhook?;
    # Your Plaid API `secret`. The `secret` is required and may be provided either in the `PLAID-SECRET` header or as part of a request body
    APISecret secret?;
    # The `secondary_client_id` is the client id of the third party with whom you would like to share the relay token
    @jsondata:Name {value: "secondary_client_id"}
    string secondaryClientId;
    # Your Plaid API `client_id`. The `client_id` is required and may be provided either in the `PLAID-CLIENT-ID` header or as part of a request body
    @jsondata:Name {value: "client_id"}
    APIClientID clientId?;
};

# PaymentInitiationRecipientCreateResponse defines the response schema for `/payment_initiation/recipient/create`
public type PaymentInitiationRecipientCreateResponse record {
    # A unique ID identifying the recipient
    string recipient_id;
    # A unique identifier for the request, which can be used for troubleshooting. This identifier, like all Plaid identifiers, is case sensitive
    RequestID request_id;
};

# A collection of objects that describe requests and responses for services
public type Services record {
    # A collection of details related to a fulfillment service or product in terms of request, process and result
    Service SERVICE;
};

# An object representing both the current pay period and year to date amount for an earning category
public type EarningsTotal record {
    # Total amount of the earnings for this pay period
    decimal? current_amount?;
    # An object representing a monetary amount
    Pay current_pay?;
    # An object representing a monetary amount
    Pay ytd_pay?;
    # Total number of hours worked for this pay period
    decimal? hours?;
    # The ISO-4217 currency code of the line item. Always `null` if `unofficial_currency_code` is non-null.
    string? iso_currency_code?;
    # The unofficial currency code associated with the line item. Always `null` if `iso_currency_code` is non-`null`. Unofficial currency codes are used for currencies that do not have official ISO currency codes, such as cryptocurrencies and the currencies of certain countries.
    # 
    # See the [currency code schema](https://plaid.com/docs/api/accounts#currency-code-schema) for a full listing of supported `unofficial_currency_code`s.
    string? unofficial_currency_code?;
    # The total year-to-date amount of the earnings
    decimal? ytd_amount?;
};

# UserFinancialDataRefreshRequest defines the request schema for `/user/financial_data/refresh`
public type UserFinancialDataRefreshRequest record {
    # A Plaid-generated ID that identifies the end user
    @jsondata:Name {value: "user_id"}
    string userId;
    # Your Plaid API `secret`. The `secret` is required and may be provided either in the `PLAID-SECRET` header or as part of a request body
    APISecret secret?;
    # Your Plaid API `client_id`. The `client_id` is required and may be provided either in the `PLAID-CLIENT-ID` header or as part of a request body
    @jsondata:Name {value: "client_id"}
    APIClientID clientId?;
};

# SandboxIncomeFireWebhookResponse defines the response schema for `/sandbox/income/fire_webhook`
public type SandboxIncomeFireWebhookResponse record {
    # A unique identifier for the request, which can be used for troubleshooting. This identifier, like all Plaid identifiers, is case sensitive
    RequestID request_id;
};

# A JSON Web Key (JWK) that can be used in conjunction with [JWT libraries](https://jwt.io/#libraries-io) to verify Plaid webhooks
public type JWKPublicKey record {
    # The alg member identifies the cryptographic algorithm family used with the key.
    string alg;
    # The crv member identifies the cryptographic curve used with the key.
    string crv;
    # The kid (Key ID) member can be used to match a specific key. This can be used, for instance, to choose among a set of keys within the JWK during key rollover.
    string kid;
    # The kty (key type) parameter identifies the cryptographic algorithm family used with the key, such as RSA or EC.
    string kty;
    # The use (public key use) parameter identifies the intended use of the public key.
    string use;
    # The x member contains the x coordinate for the elliptic curve point, provided as a base64url-encoded string of the coordinate's big endian representation.
    string x;
    # The y member contains the y coordinate for the elliptic curve point, provided as a base64url-encoded string of the coordinate's big endian representation.
    string y;
    # The timestamp when the key was created, in Unix time.
    int created_at;
    # The timestamp when the key expired, in Unix time.
    int? expired_at;
};

# Insights into a user's top merchants
public type MerchantInsights record {
    # The website associated with the merchant
    string? website;
    # Sum of outflow amounts
    @jsondata:Name {value: "total_outflows"}
    decimal totalOutflows;
    # The counterparty name
    string name;
    # The number of transactions associated with merchant of this type
    @jsondata:Name {value: "transaction_count"}
    int transactionCount;
    # Sum of inflow amounts
    @jsondata:Name {value: "total_inflows"}
    decimal totalInflows;
    # The primary personal finance category associated with this merchant
    @jsondata:Name {value: "personal_finance_category_primary"}
    string? personalFinanceCategoryPrimary;
    # A unique, stable, Plaid-generated id that maps to the merchant
    @jsondata:Name {value: "entity_id"}
    string? entityId?;
    # The detailed personal finance category associated with this merchant
    @jsondata:Name {value: "personal_finance_category_detailed"}
    string? personalFinanceCategoryDetailed;
};

# Identifying information for transferring money to or from a US account via ACH or wire transfer
public type NumbersACH record {
    # The Plaid account ID associated with the account numbers
    string account_id;
    # The ACH account number for the account.
    # 
    # At certain institutions, including Chase, PNC, and US Bank, you will receive a "tokenized" account number, which is not the user's actual account number. For important details on how this may impact your integration and on how to avoid fraud, user confusion, and ACH returns, see [Tokenized account numbers](https://plaid.com/docs/auth/#tokenized-account-numbers).
    string account;
    # Indicates whether the account number is tokenized by the institution. For important details on how tokenized account numbers may impact your integration, see [Tokenized account numbers](https://plaid.com/docs/auth/#tokenized-account-numbers).
    boolean is_tokenized_account_number?;
    # The ACH routing number for the account. For more information, see [Tokenized account numbers](https://plaid.com/docs/auth/#tokenized-account-numbers).
    string routing;
    # The wire transfer routing number for the account. This field is only populated if the institution is known to use a separate wire transfer routing number. Many institutions do not have a separate wire routing number and use the ACH routing number for wires instead. It is recommended to have the end user manually confirm their wire routing number before sending any wires to their account, especially if this field is `null`.
    string? wire_routing;
    # Whether the account supports ACH transfers into the account
    boolean? can_transfer_in?;
    # Whether the account supports ACH transfers out of the account
    boolean? can_transfer_out?;
};

# Collection of current and previous identifiers for this loan
public type LoanIdentifiers record {
    # The information used to identify this loan by various parties to the transaction or other organizations
    LoanIdentifier LOAN_IDENTIFIER;
};

# The warning code identifies a specific kind of warning.
# 
# `IDENTITY_UNAVAILABLE`: Unable to extract identity for the Item
# 
# `TRANSACTIONS_UNAVAILABLE`: Unable to extract transactions for the Item
# 
# `ITEM_UNAPPROVED`: User exited flow before giving permission to share data for the Item
# 
# `REPORT_DELETED`: Report deleted due to customer or consumer request
# 
# `DATA_UNAVAILABLE`: No relevant data was found for the Item
public type CreditBankIncomeWarningCode "IDENTITY_UNAVAILABLE"|"TRANSACTIONS_UNAVAILABLE"|"ITEM_UNAPPROVED"|"REPORT_DELETED"|"DATA_UNAVAILABLE";

# The version of cashflow attributes. Required if using Cash Flow Insights
public type CashflowAttributesVersion "v1.0"|"v2.0"|"CFI1"?;

# Configuration parameters for the Investments product
public type LinkTokenInvestments record {
    # If `true`, allow users to manually enter Investments account and holdings information. Defaults to `false`
    @jsondata:Name {value: "allow_manual_entry"}
    boolean allowManualEntry?;
    # If `true`, allow self-custody crypto wallets to be added without requiring signature verification. Defaults to `false`
    @jsondata:Name {value: "allow_unverified_crypto_wallets"}
    boolean allowUnverifiedCryptoWallets?;
};

# Information about the balance of the ledger held with Plaid
public type TransferLedgerBalance record {
    # The amount of this balance available for use (decimal string with two digits of precision e.g. "10.00").
    string available;
    # The amount of pending funds that are in processing (decimal string with two digits of precision e.g. "10.00").
    string pending;
};

# Represents the Headers record for the operation: userCreate
public type UserCreateHeaders record {
    # The HTTP header used in API requests to determine which set of User APIs to invoke: the legacy CRA version or the new User API version
    @http:Header {name: "Plaid-New-User-API-Enabled"}
    boolean plaidNewUserAPIEnabled = false;
};

# Defines the test clock for a transfer
public type TransferTestClock record {
    # Plaid's unique identifier for a test clock. This field is only populated in the Sandbox environment, and only if a `test_clock_id` was included in the `/transfer/recurring/create` request. For more details, see [Simulating recurring transfers](https://plaid.com/docs/transfer/sandbox/#simulating-recurring-transfers)
    TransferTestClockID test_clock_id;
    # The virtual timestamp on the test clock. This will be of the form `2006-01-02T15:04:05Z`
    VirtualTime virtual_time;
};

# This is a container object for all lending-related insights. This field will be returned only for European customers
public type AccountInsights record {
    # Risk indicators focus on providing signal on the possibility of a borrower defaulting on their loan repayments by providing data points related to its payment behavior, debt, and other relevant financial information, helping lenders gauge the level of risk involved in a certain operation
    RiskIndicators? risk?;
    # Affordability insights focus on providing signal on the ability of a borrower to repay their loan without experiencing financial strain. It provides insights on factors such as a user's monthly income and expenses, disposable income, average expenditure, etc., helping lenders gauge the level of affordability of a borrower
    AffordabilityInsights? affordability?;
};

# A personal finance detailed category.
# See the [taxonomy csv file](https://plaid.com/documents/pfc-taxonomy-all.csv) for a full list of personal finance categories
public type PfcDetailedCategory string;

# Request input for fetching the risk insights for a Beacon User's Bank Accounts
public type BeaconUserAccountInsightsGetRequest record {
    # The access token associated with the Item for which data is being requested
    @jsondata:Name {value: "access_token"}
    AccessToken accessToken;
    # ID of the associated Beacon User
    @jsondata:Name {value: "beacon_user_id"}
    BeaconUserID beaconUserId;
    # Your Plaid API `secret`. The `secret` is required and may be provided either in the `PLAID-SECRET` header or as part of a request body
    APISecret secret?;
    # Your Plaid API `client_id`. The `client_id` is required and may be provided either in the `PLAID-CLIENT-ID` header or as part of a request body
    @jsondata:Name {value: "client_id"}
    APIClientID clientId?;
};

# IdentityMatchListRequest defines the request schema for `/identity/match/list`
public type IdentityMatchListRequest record {
    # Opaque pagination cursor. Omit on the first request. For subsequent requests, set this field to the `next_cursor` from the previous response and use the same `start_time` and `end_time`
    string cursor?;
    # Inclusive start of the query window in RFC 3339 format
    @jsondata:Name {value: "start_time"}
    string startTime;
    # Inclusive end of the query window in RFC 3339 format
    @jsondata:Name {value: "end_time"}
    string endTime;
    # Maximum number of attempts to return in one page
    @constraint:Int {minValue: 1, maxValue: 25}
    int count = 25;
    # Your Plaid API `secret`. The `secret` is required and may be provided either in the `PLAID-SECRET` header or as part of a request body
    APISecret secret?;
    # Your Plaid API `client_id`. The `client_id` is required and may be provided either in the `PLAID-CLIENT-ID` header or as part of a request body
    @jsondata:Name {value: "client_id"}
    APIClientID clientId?;
};

# The legal name and other information for the account holder
public type TransferUserInRequest record {
    # The user's email address
    @jsondata:Name {value: "email_address"}
    string emailAddress?;
    # The address associated with the account holder
    TransferUserAddressInRequest address?;
    # The user's phone number. Phone number input may be validated against valid number ranges; number strings that do not match a real-world phone numbering scheme may cause the request to fail, even in the Sandbox test environment
    @jsondata:Name {value: "phone_number"}
    string phoneNumber?;
    # The user's legal name
    @jsondata:Name {value: "legal_name"}
    string legalName;
};

# Request input for listing watchlist screening programs for individuals
public type WatchlistScreeningIndividualProgramListRequest record {
    # An identifier that determines which page of results you receive
    Cursor? cursor?;
    # Your Plaid API `secret`. The `secret` is required and may be provided either in the `PLAID-SECRET` header or as part of a request body
    APISecret secret?;
    # Your Plaid API `client_id`. The `client_id` is required and may be provided either in the `PLAID-CLIENT-ID` header or as part of a request body
    @jsondata:Name {value: "client_id"}
    APIClientID clientId?;
};

# Defines the response schema for `/transfer/sweep/get`
public type TransferSweepGetResponse record {
    # Describes a sweep of funds to / from the sweep account.
    # 
    # A sweep is associated with many sweep events (events of type `swept` or `return_swept`) which can be retrieved by invoking the `/transfer/event/list` endpoint with the corresponding `sweep_id`.
    # 
    # `swept` events occur when the transfer amount is credited or debited from your sweep account, depending on the `type` of the transfer. `return_swept` events occur when a transfer is returned and Plaid undoes the credit or debit.
    # 
    # The total sum of the `swept` and `return_swept` events is equal to the `amount` of the sweep Plaid creates and matches the amount of the entry on your sweep account ledger
    TransferSweep sweep;
    # A unique identifier for the request, which can be used for troubleshooting. This identifier, like all Plaid identifiers, is case sensitive
    RequestID request_id;
};

# Defines the response schema for `/bank_transfer/balance/get`
public type BankTransferBalanceGetResponse record {
    # Information about the balance of a bank transfer
    BankTransferBalance balance;
    # The ID of the origination account that this balance belongs to.
    string? origination_account_id;
    # A unique identifier for the request, which can be used for troubleshooting. This identifier, like all Plaid identifiers, is case sensitive
    RequestID request_id;
};

# An object representing the e-wallet account numbers
public type WalletNumbers record {
    # An object containing a Bacs account number and sort code. If an IBAN is not provided or if you need to accept domestic GBP-denominated payments, Bacs data is required
    RecipientBACS? bacs?;
    # Account numbers using the International Bank Account Number and BIC/SWIFT code format
    NumbersInternationalIBAN? international?;
};

# Maximum amount of a single payment initiated using the payment consent
public type PaymentConsentMaxPaymentAmount PaymentAmount;

# Specify the account used to fund the transfer. Should be specified if using legacy funding methods only. If using Plaid Ledger, leave this field blank. Customers can find a list of `funding_account_id`s in the Accounts page of your Plaid Dashboard, under the "Account ID" column. If this field is left blank and you are using legacy funding methods, this will default to the default `funding_account_id` specified during onboarding. Otherwise, Plaid Ledger will be used
public type TransferMigratedFundingAccountIDRequest string?;

# ProcessorTokenPermissionsSetRequest defines the request schema for `/processor/token/permissions/set`
public type ProcessorTokenPermissionsSetRequest record {
    # Your Plaid API `secret`. The `secret` is required and may be provided either in the `PLAID-SECRET` header or as part of a request body
    APISecret secret?;
    # The processor token obtained from the Plaid integration partner. Processor tokens are in the format: `processor-<environment>-<identifier>`
    @jsondata:Name {value: "processor_token"}
    ProcessorToken processorToken;
    # Your Plaid API `client_id`. The `client_id` is required and may be provided either in the `PLAID-CLIENT-ID` header or as part of a request body
    @jsondata:Name {value: "client_id"}
    APIClientID clientId?;
    # A list of products the processor token should have access to. An empty list will grant access to all products
    Products[] products;
};

# This event type represents a user signing in to the application
public type ProtectUserSignInEvent record {
};

# Name of a cluster of data elements permissioned by a consent grant
public type FDXDataCluster "ACCOUNT_BASIC"|"ACCOUNT_DETAILED"|"ACCOUNT_PAYMENTS"|"BILLS"|"CUSTOMER_CONTACT"|"CUSTOMER_PERSONAL"|"IMAGES"|"INVESTMENTS"|"NOTIFICATIONS"|"PAYMENT_SUPPORT"|"REWARDS"|"STATEMENTS"|"TAX"|"TRANSACTIONS"|"BALANCES"|"SCHEDULED_PAYMENTS";

# A transaction on the asset report
public type AssetReportTransaction record {
    # The ID of the account in which this transaction occurred.
    string account_id;
    # The settled value of the transaction, denominated in the transaction's currency, as stated in `iso_currency_code` or `unofficial_currency_code`. Positive values when money moves out of the account; negative values when money moves in. For example, debit card purchases are positive; credit card payments, direct deposits, and refunds are negative.
    decimal amount;
    # The ISO-4217 currency code of the transaction. Always `null` if `unofficial_currency_code` is non-null.
    string? iso_currency_code;
    # The unofficial currency code associated with the transaction. Always `null` if `iso_currency_code` is non-`null`. Unofficial currency codes are used for currencies that do not have official ISO currency codes, such as cryptocurrencies and the currencies of certain countries.
    # 
    # See the [currency code schema](https://plaid.com/docs/api/accounts#currency-code-schema) for a full listing of supported `unofficial_currency_code`s.
    string? unofficial_currency_code;
    # The string returned by the financial institution to describe the transaction.
    string? original_description;
    # A hierarchical array of the categories to which this transaction belongs. For a full list of categories, see [`/categories/get`](https://plaid.com/docs/api/products/transactions/#categoriesget).
    # 
    # This field will only appear in an Asset Report with Insights.
    string[]? category?;
    # The ID of the category to which this transaction belongs. For a full list of categories, see [`/categories/get`](https://plaid.com/docs/api/products/transactions/#categoriesget).
    # 
    # This field will only appear in an Asset Report with Insights.
    string? category_id?;
    # Information describing the intent of the transaction. Most relevant for credit use cases, but not limited to such use cases.
    # 
    # See the [`taxonomy csv file`](https://plaid.com/documents/credit-category-taxonomy.csv) for a full list of credit categories
    CreditCategory? credit_category?;
    # The check number of the transaction. This field is only populated for check transactions.
    string? check_number?;
    # For pending transactions, the date that the transaction occurred; for posted transactions, the date that the transaction posted. Both dates are returned in an [ISO 8601](https://wikipedia.org/wiki/ISO_8601) format ( `YYYY-MM-DD` ).
    string date;
    # The date on which the transaction took place, in ISO 8601 format.
    string? date_transacted?;
    # A representation of where a transaction took place. Location data is provided only for transactions at physical locations, not for online transactions. Location data availability depends primarily on the merchant and is most likely to be populated for transactions at large retail chains; small, local businesses are less likely to have location data available
    Location location?;
    # The merchant name or transaction description. This is a legacy field that is no longer maintained. For merchant name, use the `merchant_name` field. For description, use the `original_description` field.
    # 
    # This field will only appear in an Asset Report with Insights.
    # 
    # # Deprecated
    @deprecated
    string name?;
    # The merchant name, as enriched by Plaid. This is typically a more human-readable version of the merchant counterparty in the transaction. For some bank transactions (such as checks or account transfers) where there is no meaningful merchant name, this value will be `null`.
    string? merchant_name?;
    # Transaction information specific to inter-bank transfers. If the transaction was not an inter-bank transfer, all fields will be `null`.
    # 
    # If the `transactions` object was returned by a Transactions endpoint such as `/transactions/sync` or `/transactions/get`, the `payment_meta` key will always appear, but no data elements are guaranteed. If the `transactions` object was returned by an Assets endpoint such as `/asset_report/get` or `/asset_report/pdf/get`, this field will only appear in an Asset Report with Insights
    PaymentMeta payment_meta?;
    # When `true`, identifies the transaction as pending or unsettled. Pending transaction details (name, type, amount, category ID) may change before they are settled.
    boolean pending;
    # The ID of a posted transaction's associated pending transaction, where applicable.
    string? pending_transaction_id?;
    # The name of the account owner. This field is not typically populated and only relevant when dealing with sub-accounts.
    string? account_owner?;
    # The unique ID of the transaction. Like all Plaid identifiers, the `transaction_id` is case sensitive.
    string transaction_id;
    # `digital:` transactions that took place online.
    # 
    # `place:` transactions that were made at a physical location.
    # 
    # `special:` transactions that relate to banks, e.g. fees or deposits.
    # 
    # `unresolved:` transactions that do not fit into the other three types
    AssetReportTransactionType transaction_type?;
    # A unique identifier for an income source.
    string income_source_id?;
};

# The status of the loan
public type CraLoanStatus "APPROVED"|"DECLINED"|"BOOKED"|"CURRENT"|"DELINQUENT"|"DEFAULT"|"CHARGED_OFF"|"TRANSFERRED"|"PAID_OFF"|"OTHER";

