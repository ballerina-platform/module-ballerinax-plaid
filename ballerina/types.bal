    LinkSessionSuccessMetadataInstitution? institution;
};

# UserItemsGetRequest defines the request schema for `/user/items/get`
public type UserItemsGetRequest record {
    # A unique user identifier, created by `/user/create`. Integrations that began using `/user/create` after December 10, 2025 use this field to identify a user instead of the `user_token`. For more details, see [New User APIs](https://plaid.com/docs/api/users/user-apis)
    @jsondata:Name {value: "user_id"}
    NewUserID userId?;
    # Your Plaid API `secret`. The `secret` is required and may be provided either in the `PLAID-SECRET` header or as part of a request body
    APISecret secret?;
    # The user token associated with the user for which data is being requested. This field is used only by customers with pre-existing integrations that already use the `user_token` field. All other customers should use the `user_id` instead. For more details, see [New User APIs](https://plaid.com/docs/api/users/user-apis)
    @jsondata:Name {value: "user_token"}
    UserToken userToken?;
    # Your Plaid API `client_id`. The `client_id` is required and may be provided either in the `PLAID-CLIENT-ID` header or as part of a request body
    @jsondata:Name {value: "client_id"}
    APIClientID clientId?;
};

# The direction of the transaction from the perspective of the account holder:
# 
# `OUTFLOW` - Includes outgoing transfers, purchases, and fees. (Typically represented as a negative value on checking accounts and debit cards and a positive value on credit cards.)
# 
# `INFLOW` - Includes incoming transfers, refunds, and income. (Typically represented as a positive value on checking accounts and debit cards and a negative value on credit cards.)
public type EnrichTransactionDirection "INFLOW"|"OUTFLOW";

# Defines the request schema for `/transfer/return/recover`
public type TransferReturnRecoverRequest record {
    # The amount being recovered (decimal string with two digits of precision e.g. "10.00"). The sum of recovered amounts across calls cannot exceed the original transfer's amount
    TransferReturnRecoverAmount amount;
    # A random key provided by the client, per unique recovery. Maximum of 50 characters.
    # 
    # The API supports idempotency for safely retrying requests without accidentally performing the same operation twice. For example, if a request to report a recovery fails due to a network connection error, you can retry the request with the same idempotency key to guarantee that only a single recovery is recorded
    @jsondata:Name {value: "idempotency_key"}
    TransferReturnRecoverIdempotencyKey idempotencyKey;
    # Your Plaid API `secret`. The `secret` is required and may be provided either in the `PLAID-SECRET` header or as part of a request body
    APISecret secret?;
    # The ID of the returned transfer that was recovered
    @jsondata:Name {value: "transfer_id"}
    TransferReturnRecoverTransferID transferId;
    # Your Plaid API `client_id`. The `client_id` is required and may be provided either in the `PLAID-CLIENT-ID` header or as part of a request body
    @jsondata:Name {value: "client_id"}
    APIClientID clientId?;
};

# The version of the credit profile report to retrieve
public type CraCreditProfileReportVersion "v1";

# Defines the request schema for `/transfer/list`
public type TransferListRequest record {
    # The end `created` datetime of transfers to list. This should be in RFC 3339 format (i.e. `2019-12-06T22:35:49Z`)
    @jsondata:Name {value: "end_date"}
    string? endDate?;
    # Filter transfers to only those with the specified `funding_account_id`
    @jsondata:Name {value: "funding_account_id"}
    string? fundingAccountId?;
    # Filter transfers to only those with the specified originator client
    @jsondata:Name {value: "originator_client_id"}
    string? originatorClientId?;
    # The number of transfers to skip before returning results
    @constraint:Int {minValue: 0}
    int offset = 0;
    # The maximum number of transfers to return
    @constraint:Int {minValue: 1, maxValue: 25}
    int count = 25;
    # Filter transfers to only those originated through the specified origination account
    # 
    # # Deprecated
    @jsondata:Name {value: "origination_account_id"}
    @deprecated
    string? originationAccountId?;
    # Your Plaid API `secret`. The `secret` is required and may be provided either in the `PLAID-SECRET` header or as part of a request body
    APISecret secret?;
    # Your Plaid API `client_id`. The `client_id` is required and may be provided either in the `PLAID-CLIENT-ID` header or as part of a request body
    @jsondata:Name {value: "client_id"}
    APIClientID clientId?;
    # The start `created` datetime of transfers to list. This should be in RFC 3339 format (i.e. `2019-12-06T22:35:49Z`)
    @jsondata:Name {value: "start_date"}
    string? startDate?;
};

