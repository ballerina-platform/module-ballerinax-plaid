# Describes the frequency of the transaction stream.
# 
# `WEEKLY`: Assigned to a transaction stream that occurs approximately every week.
# 
# `BIWEEKLY`: Assigned to a transaction stream that occurs approximately every 2 weeks.
# 
# `SEMI_MONTHLY`: Assigned to a transaction stream that occurs approximately twice per month. This frequency is typically seen for inflow transaction streams.
# 
# `MONTHLY`: Assigned to a transaction stream that occurs approximately every month.
# 
# `ANNUALLY`: Assigned to a transaction stream that occurs approximately every year.
# 
# `UNKNOWN`: Assigned to a transaction stream that does not fit any of the pre-defined frequencies
public type RecurringTransactionFrequency "UNKNOWN"|"WEEKLY"|"BIWEEKLY"|"SEMI_MONTHLY"|"MONTHLY"|"ANNUALLY";

# The details of a cash-advance associated with the decision. Required when `is_taken` is `true`
public type CashAdvanceInfo record {
    # The amount a user was approved for in a cash-advance.
    Amount amount_approved;
    # The amount a user is required to pay, including any fees or additional amounts. Required if `is_taken` is `true`.
    Amount amount_due?;
    # The date the cash-advance is due, in ISO 8601 format (`YYYY-MM-DD`). Required if `is_taken` is `true`.
    string due_date?;
};

# The warning associated with the data that was unavailable for the Bank Employment Report
public type CreditBankEmploymentWarning record {
    # The warning type which will always be `BANK_EMPLOYMENT_WARNING`
    @jsondata:Name {value: "warning_type"}
    CreditBankEmploymentWarningType warningType;
    # An error object and associated `item_id` used to identify a specific Item and error when a batch operation operating on multiple Items has encountered an error in one of the Items
    CreditBankIncomeCause cause;
    # The warning code identifies a specific kind of warning.
    # 
    # `IDENTITY_UNAVAILABLE`: Unable to extract identity for the Item
    # 
    # `TRANSACTIONS_UNAVAILABLE`: Unable to extract transactions for the Item
    # 
    # `ITEM_UNAPPROVED`: User exited flow before giving permission to share data for the Item
    # 
    # `REPORT_DELETED`: Report deleted due to customer or consumer request
    # 
    # `DATA_UNAVAILABLE`: No relevant data was found for the Item
    @jsondata:Name {value: "warning_code"}
    CreditBankIncomeWarningCode warningCode;
};

# An income stream detected for the user
public type CraVerificationIncomeStream record {
    # A unique identifier for an income stream. If the report is regenerated and a new `report_id` is created, the new report will have a new set of `income_stream_id`s.
    string income_stream_id;
    # Minimum of all dates within the specific income stream for days requested by the client. The date will be returned in an ISO 8601 format (YYYY-MM-DD).
    string start_date;
    # Maximum of all dates within the specific income stream for days requested by the client. The date will be returned in an ISO 8601 format (YYYY-MM-DD).
    string end_date;
    # The most common name or original description for the underlying income transactions.
    string description;
    # Modeled insights for a given income stream
    CraVerificationIncomeStreamInsights insights;
    # Modeled income metrics for a given income stream or user summary
    CraVerificationIncomeMetrics income_metrics;
    # The transactions data for the income stream ordered by ascending date.
    CraVerificationIncomeTransaction[] transactions;
};

