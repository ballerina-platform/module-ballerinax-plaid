# SandboxItemFireWebhookRequest defines the request schema for `/sandbox/item/fire_webhook`
public type SandboxItemFireWebhookRequest record {
    # The access token associated with the Item for which data is being requested
    @jsondata:Name {value: "access_token"}
    AccessToken accessToken;
    # The webhook types that can be fired by this test endpoint
    @jsondata:Name {value: "webhook_type"}
    WebhookType webhookType?;
    # Your Plaid API `secret`. The `secret` is required and may be provided either in the `PLAID-SECRET` header or as part of a request body
    APISecret secret?;
    # The webhook codes that can be fired by this test endpoint
    @jsondata:Name {value: "webhook_code"}
    "DEFAULT_UPDATE"|"NEW_ACCOUNTS_AVAILABLE"|"SMS_MICRODEPOSITS_VERIFICATION"|"AUTHORIZATION_GRANTED"|"USER_PERMISSION_REVOKED"|"USER_ACCOUNT_REVOKED"|"PENDING_DISCONNECT"|"RECURRING_TRANSACTIONS_UPDATE"|"LOGIN_REPAIRED"|"SYNC_UPDATES_AVAILABLE"|"PRODUCT_READY"|"ERROR" webhookCode;
    # Your Plaid API `client_id`. The `client_id` is required and may be provided either in the `PLAID-CLIENT-ID` header or as part of a request body
    @jsondata:Name {value: "client_id"}
    APIClientID clientId?;
};

# Optional parameters to `/accounts/balance/get`
public type AccountsBalanceGetRequestOptions record {
    # A list of `account_ids` to retrieve for the Item. The default value is `null`.
    # 
    # Note: An error will be returned if a provided `account_id` is not associated with the Item
    @jsondata:Name {value: "account_ids"}
    string[] accountIds?;
    # Timestamp in [ISO 8601](https://wikipedia.org/wiki/ISO_8601) format (`YYYY-MM-DDTHH:mm:ssZ`) indicating the oldest acceptable balance when making a request to `/accounts/balance/get`.
    # 
    # This field is only necessary when the institution is `ins_128026` (Capital One), *and* one or more account types being requested is a non-depository account (such as a credit card) as Capital One does not provide real-time balance for non-depository accounts. In this case, a value must be provided or an `INVALID_REQUEST` error with the code of `INVALID_FIELD` will be returned. For all other institutions, as well as for depository accounts at Capital One (including all checking and savings accounts) this field is ignored and real-time balance information will be fetched.
    # 
    # If this field is not ignored, and no acceptable balance is available, an `INVALID_RESULT` error with the code `LAST_UPDATED_DATETIME_OUT_OF_RANGE` will be returned
    @jsondata:Name {value: "min_last_updated_datetime"}
    MinLastUpdatedDatetime minLastUpdatedDatetime?;
};

# Detailed address information for a business from data provider
public type ProviderBusinessAddress record {
    # Valid, capitalized, two-letter ISO code representing the country of this object. Must be in ISO 3166-1 alpha-2 form
    GenericCountryCode country;
    # Whether this is the primary address for the business
    @jsondata:Name {value: "is_primary"}
    boolean isPrimary;
    # City from the address. A string with at least one non-whitespace alphabetical character, with a max length of 100 characters
    CityNullable? city;
    # The primary street portion of an address. If an address is provided, this field will always be filled. A string with at least one non-whitespace alphabetical character, with a max length of 80 characters
    StreetNullable? street;
    # Extra street information, like an apartment or suite number. If provided, a string with at least one non-whitespace character, with a max length of 50 characters
    Street2? street2;
    # A subdivision code. "Subdivision" is a generic term for "state", "province", "prefecture", "zone", etc. For the list of valid codes, see [country subdivision codes](https://plaid.com/documents/country_subdivision_codes.json). Country prefixes are omitted, since they are inferred from the `country` field
    Region? region;
    # The postal code for the associated address. Between 2 and 10 alphanumeric characters. For US-based addresses this must be 5 numeric digits
    @jsondata:Name {value: "postal_code"}
    PostalCode? postalCode;
};

