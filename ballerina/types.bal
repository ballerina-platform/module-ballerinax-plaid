public type LoanPaymentFrequency "daily"|"weekly"|"biweekly"|"semimonthly"|"monthly"|"semiannually"|"annually"?;

# A field that may be required to be submitted for enablement
public type PartnerEndCustomerRequirementDue "legal_entity_name"|"website"|"application_name"|"is_diligence_attested"|"technical_contact"|"billing_contact"|"address"|"bank_addendum_acceptance"|"questionnaires.cra";

