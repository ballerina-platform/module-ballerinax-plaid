# A unique ID identifying a Base Report. Like all Plaid identifiers, this ID is case sensitive
public type BaseReportId string;

# A review submitted by a team member for an individual watchlist screening. A review can be either a comment on the current screening state, actions taken
# against hits attached to the watchlist screening, or both
public type WatchlistScreeningReview record {
    # ID of the associated review
    WatchlistScreeningReviewID id;
    # Hits marked as a true positive after thorough manual review. These hits will never recur or be updated once confirmed. In most cases, confirmed hits indicate that the customer should be rejected.
    WatchlistScreeningHitID[] confirmed_hits;
    # Hits marked as a false positive after thorough manual review. These hits will never recur or be updated once dismissed.
    WatchlistScreeningHitID[] dismissed_hits;
    # A comment submitted by a team member as part of reviewing a watchlist screening
    ReviewComment? comment;
    # Information about the last change made to the parent object specifying what caused the change as well as when it occurred
    WatchlistScreeningAuditTrail audit_trail;
};

# Information about the balance of a bank transfer
public type BankTransferBalance record {
    # The total available balance - the sum of all successful debit transfer amounts minus all credit transfer amounts.
    string available;
    # The transactable balance shows the amount in your account that you are able to use for transfers, and is essentially your available balance minus your minimum balance.
    string transactable;
};

# Modeled income metrics for a given income stream or user summary
public type CraIncomeMetrics record {
    # Modeled estimate of current income based on recently observed income transactions
    CraCurrentModeledIncome? current;
    # Forward-looking modeled estimate of income based on recent income transactions and trends in active streams
    CraProjectedModeledIncome? projected;
    # The ISO 4217 currency code of the amount or balance
    CreditIsoCurrencyCode? iso_currency_code;
    # The unofficial currency code associated with the amount or balance. Always `null` if `iso_currency_code` is non-null.
    # Unofficial currency codes are used for currencies that do not have official ISO currency codes, such as cryptocurrencies and the currencies of certain countries
    CreditUnofficialCurrencyCode? unofficial_currency_code;
};

# CraCheckReportBaseReportGetRequest defines the request schema for `/cra/check_report/base_report/get`
public type CraCheckReportBaseReportGetRequest record {
    # A unique user identifier, created by `/user/create`. Integrations that began using `/user/create` after December 10, 2025 use this field to identify a user instead of the `user_token`. For more details, see [New User APIs](https://plaid.com/docs/api/users/user-apis)
    @jsondata:Name {value: "user_id"}
    NewUserID userId?;
    # The CRA report token (formatted `cra-report-<env>-<uuid>`) identifying a specific consumer report. When provided alongside `consumer_report_permissible_purpose`, pins retrieval to that report and stamps its permissible purpose. If omitted, the most recently generated report for the user is returned
    @jsondata:Name {value: "report_id"}
    string reportId?;
    # The Item IDs to include in the Base Report. If not provided, all Items associated with the user will be included
    @jsondata:Name {value: "item_ids"}
    ItemId[]? itemIds?;
    # The tier of the user
    @jsondata:Name {value: "user_tier"}
    CraUserTier? userTier?;
    # Your Plaid API `secret`. The `secret` is required and may be provided either in the `PLAID-SECRET` header or as part of a request body
    APISecret secret?;
    # The third-party user token associated with the requested User data
    @jsondata:Name {value: "third_party_user_token"}
    ThirdPartyUserToken thirdPartyUserToken?;
    # The user token associated with the user for which data is being requested. This field is used only by customers with pre-existing integrations that already use the `user_token` field. All other customers should use the `user_id` instead. For more details, see [New User APIs](https://plaid.com/docs/api/users/user-apis)
    @jsondata:Name {value: "user_token"}
    UserToken userToken?;
    # The permissible purpose under which the consumer report is being retrieved
    @jsondata:Name {value: "consumer_report_permissible_purpose"}
    CraCheckReportPermissiblePurpose consumerReportPermissiblePurpose?;
    # Your Plaid API `client_id`. The `client_id` is required and may be provided either in the `PLAID-CLIENT-ID` header or as part of a request body
    @jsondata:Name {value: "client_id"}
    APIClientID clientId?;
};

# W2 state and local wages
public type W2StateAndLocalWages record {
