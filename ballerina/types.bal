# Result summary object specifying values for `email` attributes of risk check
public type RiskCheckEmail record {
    # SMTP-MX check to confirm the email address exists if known
    RiskCheckEmailIsDeliverableStatus is_deliverable;
    # Count of all known breaches of this email address if known.
    int? breach_count;
    # A date in the format YYYY-MM-DD (RFC 3339 Section 5.6)
    ISO8601DateNullable? first_breached_at;
    # A date in the format YYYY-MM-DD (RFC 3339 Section 5.6)
    ISO8601DateNullable? last_breached_at;
    # A date in the format YYYY-MM-DD (RFC 3339 Section 5.6)
    ISO8601DateNullable? domain_registered_at;
    # Indicates whether the email address domain is a free provider such as Gmail or Hotmail if known
    RiskCheckEmailDomainIsFreeProvider domain_is_free_provider;
    # Indicates whether the email address domain is custom if known, i.e. a company domain and not free or disposable
    RiskCheckEmailDomainIsCustom domain_is_custom;
    # Indicates whether the email domain is listed as disposable if known. Disposable domains are often used to create email addresses that are part of a fake set of user details
    RiskCheckEmailDomainIsDisposable domain_is_disposable;
    # Indicates whether the email address top level domain, which is the last part of the domain, is fraudulent or risky if known. In most cases, a suspicious top level domain is also associated with a disposable or high-risk domain
    RiskCheckEmailTopLevelDomainIsSuspicious top_level_domain_is_suspicious;
    # Indicates whether the email address domain is an educational institution domain if known
    RiskCheckEmailIsEdu is_edu;
    # Indicates whether the email address includes the date of birth or year of birth if known
    RiskCheckEmailIncludesDateOfBirth includes_date_of_birth;
    # Indicates whether the provided name matches the email address according to the KYC name-matches-email inference result if known.
    # 
    # `match` - "The email's name identifiers match the user's name."
    # 
    # `partial_match` - "The email's name identifiers partially match the user's name."
    # 
    # `no_match` - "The email's name identifiers do not match the user's name."
    # 
    # `indeterminate` - "The email does not contain any name identifiers, and a match could not be determined."
    # 
    # `no_input` - "The user's profile does not contain the required user inputs to determine a match."
    # 
    # `no_data` - "Field could not be verified against available sources."
    RiskCheckEmailName name;
    # A list of online services where this email address has been detected to have accounts or other activity.
    RiskCheckLinkedService[] linked_services;
    # Risk level for the given risk check type
    RiskLevel risk_level?;
    # List of factors, when available, that contribute towards the risk level of the given risk check type
    RiskCheckFactors factors?;
};

# A representation of the status health of a request type. Auth requests, Balance requests, Identity requests, Investments requests, Liabilities requests, Transactions updates, Investments updates, Liabilities updates, and Item logins each have their own status object
public type ProductStatus record {
    # This field is deprecated in favor of the `breakdown` object, which provides more granular institution health data.
    # 
    # `HEALTHY`: the majority of requests are successful
    # 
    # `DEGRADED`: only some requests are successful
    # 
    # `DOWN`: all requests are failing
    # 
    # # Deprecated
    @deprecated
    "HEALTHY"|"DEGRADED"|"DOWN" status;
    # [ISO 8601](https://wikipedia.org/wiki/ISO_8601) formatted timestamp of the last status change for the institution.
    string last_status_change;
    # A detailed breakdown of the institution's performance for a request type. The values for `success`, `error_plaid`, and `error_institution` sum to 1. The time range used for calculating the breakdown may range from the most recent few minutes to the past six hours. In general, smaller institutions will show status that was calculated over a longer period of time. For Investment updates, which are refreshed less frequently, the period assessed may be 24 hours or more. For more details, see [Institution status details](https://plaid.com/docs/account/activity/#troubleshooting-institution-insights)
    ProductStatusBreakdown breakdown;
};

