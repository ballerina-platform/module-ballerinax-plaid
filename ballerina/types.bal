# ACH numbers for verification via Database Auth
public type AuthVerifyNumbersACH record {
    # Account's routing number
    string routing;
    # Account's account number
    string account;
};

# The details of a Plaid Check Item update via update mode in Link
public type LinkSessionCraUpdateResult record {
    # The Plaid Check Item ID. The `item_id` is always unique; linking the same account at the same institution twice will result in two Items with different `item_id` values. The `item_id` is case-sensitive.
    string item_id;
    # A list of accounts attached to the connected Item. If Account Select is enabled via the developer dashboard, `accounts` will only include selected accounts.
    LinkSessionSuccessMetadataAccount[] accounts;
    # An institution object. If the Item was created via Same-Day or Instant micro-deposit verification, will be `null`
    LinkSessionSuccessMetadataInstitution? institution;
};

# Specifies the originator's expected usage of debits. For all dollar amounts, use a decimal string with two digits of precision e.g. "10.00". This field is required if the originator is expected to process debit transfers
public type TransferDebitUsageConfiguration record {
    # The originator's monthly expected ACH debit processing amount for the next 6-12 months
    @jsondata:Name {value: "expected_monthly_amount"}
    string expectedMonthlyAmount;
    # The originator's expected transfer frequency
    @jsondata:Name {value: "expected_frequency"}
    OriginatorExpectedTransferFrequency expectedFrequency;
    # The originator's expected average amount per debit
    @jsondata:Name {value: "expected_average_amount"}
    string expectedAverageAmount;
    # Specifies the expected use cases for the originator's debit transfers. This should be a list that contains one or more of the following codes:
    # 
    # `"ccd"` - Corporate Credit or Debit - fund transfer between two corporate bank accounts
    # 
    # `"ppd"` - Prearranged Payment or Deposit - The transfer is part of a pre-existing relationship with a consumer. Authorization was obtained in writing either in person or via an electronic document signing, e.g. Docusign, by the consumer. Can be used for credits or debits.
    # 
    # `"web"` - Internet-Initiated Entry. The transfer debits a consumer's bank account. Authorization from the consumer is obtained over the Internet (e.g. a web or mobile application). Can be used for single debits or recurring debits.
    # 
    # `"tel"` - Telephone-Initiated Entry. The transfer debits a consumer. Debit authorization has been received orally over the telephone via a recorded call
    @jsondata:Name {value: "sec_codes"}
    ACHClass[] secCodes;
    # The originator's expected highest amount for a single debit transfer
    @jsondata:Name {value: "expected_highest_amount"}
    string expectedHighestAmount;
};

# Plaid's unique identifier for a sweep
public type TransferSweepIDNullable string?;

# PaymentInitiationPaymentListRequest defines the request schema for `/payment_initiation/payment/list`
public type PaymentInitiationPaymentListRequest record {
    # A string in RFC 3339 format (i.e. "2019-12-06T22:35:49Z"). Only payments created before the cursor will be returned
    string? cursor?;
    # The maximum number of payments to return. If `count` is not specified, a maximum of 10 payments will be returned, beginning with the most recent payment before the cursor (if specified)
    int? count = 10;
    # Your Plaid API `secret`. The `secret` is required and may be provided either in the `PLAID-SECRET` header or as part of a request body
    APISecret secret?;
    # Your Plaid API `client_id`. The `client_id` is required and may be provided either in the `PLAID-CLIENT-ID` header or as part of a request body
    @jsondata:Name {value: "client_id"}
    APIClientID clientId?;
    # The consent ID. If specified, only payments, executed using this consent, will be returned
    @jsondata:Name {value: "consent_id"}
    string? consentId?;
};

# Represents a refund within the Transfers API
public type TransferRefund record {
    # Plaid's unique identifier for a refund
    TransferRefundID id;
    # The ID of the transfer to refund
    TransferIDForRefund transfer_id;
    # The amount of the refund (decimal string with two digits of precision e.g. "10.00")
    TransferRefundAmount amount;
    # The status of the refund.
    # 
    # `pending`: A new refund was created; it is in the pending state.
    # 
    # `posted`: The refund has been successfully submitted to the payment network.
    # 
    # `settled`: Credits have been refunded to the Plaid linked account.
    # 
    # `cancelled`: The refund was cancelled by the client.
    # 
    # `failed`: The refund has failed.
    # 
    # `returned`: The refund was returned
    TransferRefundStatus status;
    # The failure reason if the status for a refund is `"failed"` or `"returned"`. Null value otherwise
    TransferRefundFailure? failure_reason;
    # Plaid's unique identifier for a Plaid Ledger Balance
    TransferLedgerID? ledger_id?;
    # The datetime when this refund was created. This will be of the form `2006-01-02T15:04:05Z`
    string created;
    # The trace identifier for the transfer based on its network. This will only be set after the transfer has posted.
    # 
    # For `ach` or `same-day-ach` transfers, this is the ACH trace number.
    # For `rtp` transfers, this is the Transaction Identification number.
    # For `wire` transfers, this is the IMAD (Input Message Accountability Data) number
    TransferNetworkTraceID? network_trace_id?;
};

# Represents a ledger event in the Transfers API
public type TransferLedgerEvent record {
    # Plaid's unique identifier for this ledger event.
    string ledger_event_id;
    # The ID of the ledger this event belongs to.
    string ledger_id;
    # The amount of the ledger event as a decimal string.
    string amount;
    # The ID of the transfer source that triggered this ledger event.
    string? transfer_id?;
    # The ID of the refund source that triggered this ledger event.
    string? refund_id?;
    # The ID of the sweep source that triggered this ledger event.
    string? sweep_id?;
    # A description of the ledger event.
    string description;
    # The new pending balance after this event.
    string pending_balance;
    # The new available balance after this event.
    string available_balance;
    # The type of balance that was impacted by this event.
    string 'type;
    # The datetime when this ledger event occurred.
    string timestamp;
};

# Request input for getting a Beacon Report Syndication
public type BeaconReportSyndicationGetRequest record {
    # ID of the associated Beacon Report Syndication
    @jsondata:Name {value: "beacon_report_syndication_id"}
    BeaconReportSyndicationID beaconReportSyndicationId;
    # Your Plaid API `secret`. The `secret` is required and may be provided either in the `PLAID-SECRET` header or as part of a request body
    APISecret secret?;
    # Your Plaid API `client_id`. The `client_id` is required and may be provided either in the `PLAID-CLIENT-ID` header or as part of a request body
    @jsondata:Name {value: "client_id"}
    APIClientID clientId?;
};

# Information associated with the watchlist hit
public type ScreeningHitData record {
    # Dates of birth associated with the watchlist hit
    ScreeningHitDateOfBirthItem[] dates_of_birth?;
    # Documents associated with the watchlist hit
    ScreeningHitDocumentsItems[] documents?;
    # Locations associated with the watchlist hit
    GenericScreeningHitLocationItems[] locations?;
    # Names associated with the watchlist hit
    ScreeningHitNamesItems[] names?;
};

# The reason for terminating products.
# 
# `FRAUD_FIRST_PARTY`: The end user who owns the connected bank account committed fraud using their real identity
# 
# `FRAUD_FALSE_IDENTITY`: The connection was created using a false or stolen identity
# 
# `FRAUD_ABUSE`: The end user is abusing the client's service or platform (for example, automation or excessive retries) through their connected account
# 
# `FRAUD_OTHER`: Fraud-related, but not covered by the specific fraud categories above; `reason_note` should clarify
# 
# `FRAUD_TRANSACTION`: Fraud occurred at the transaction level, such as an unauthorized transaction, card testing, chargeback, ACH return, or dispute
# 
# `CONSUMER_LOAN_PAID_OFF`: The end user paid off their loan and no longer needs the product
# 
# `CONSUMER_ACCOUNT_CLOSED`: The end user closed their account with the client and no longer needs the product
# 
# `CONSUMER_CHARGE_OFF`: The end user's account has been charged off
# 
# `CONSUMER_PAYMENT_METHOD_SWITCHED`: The end user switched to a different payment method and no longer needs the product
# 
# `USER_OFFBOARDING`: The user is offboarding from the client's service or platform
# 
# `DUPLICATE_ITEM`: This Item is a duplicate of another active Item for the same user
# 
# `BILLING_TERMINATION`: The client's billing or subscription relationship with the end user has ended
# 
# `OTHER`: None of the above; `reason_note` should clarify
public type ProductsTerminateReasonCode "FRAUD_FIRST_PARTY"|"FRAUD_FALSE_IDENTITY"|"FRAUD_ABUSE"|"FRAUD_OTHER"|"FRAUD_TRANSACTION"|"CONSUMER_LOAN_PAID_OFF"|"CONSUMER_ACCOUNT_CLOSED"|"CONSUMER_CHARGE_OFF"|"CONSUMER_PAYMENT_METHOD_SWITCHED"|"USER_OFFBOARDING"|"DUPLICATE_ITEM"|"BILLING_TERMINATION"|"OTHER";

# CreditPayrollIncomeRefreshRequest defines the request schema for `/credit/payroll_income/refresh`
public type CreditPayrollIncomeRefreshRequest record {
    # A unique user identifier, created by `/user/create`. Integrations that began using `/user/create` after December 10, 2025 use this field to identify a user instead of the `user_token`. For more details, see [New User APIs](https://plaid.com/docs/api/users/user-apis)
    @jsondata:Name {value: "user_id"}
    NewUserID userId?;
    # An optional object for `/credit/payroll_income/refresh` request options
    CreditPayrollIncomeRefreshRequestOptions options?;
    # Your Plaid API `secret`. The `secret` is required and may be provided either in the `PLAID-SECRET` header or as part of a request body
    APISecret secret?;
    # The user token associated with the user for which data is being requested. This field is used only by customers with pre-existing integrations that already use the `user_token` field. All other customers should use the `user_id` instead. For more details, see [New User APIs](https://plaid.com/docs/api/users/user-apis)
    @jsondata:Name {value: "user_token"}
    UserToken userToken?;
    # Your Plaid API `client_id`. The `client_id` is required and may be provided either in the `PLAID-CLIENT-ID` header or as part of a request body
    @jsondata:Name {value: "client_id"}
    APIClientID clientId?;
};

# Physical address of a business. Used for input requests
public type RequestBusinessAddress record {
    # The primary street portion of an address. If an address is provided, this field will always be filled. A string with at least one non-whitespace alphabetical character, with a max length of 80 characters
    Street street;
    # Extra street information, like an apartment or suite number. If provided, a string with at least one non-whitespace character, with a max length of 50 characters
    Street2? street2?;
    # City from the address. A string with at least one non-whitespace alphabetical character, with a max length of 100 characters
    City city;
    # A subdivision code. "Subdivision" is a generic term for "state", "province", "prefecture", "zone", etc. For the list of valid codes, see [country subdivision codes](https://plaid.com/documents/country_subdivision_codes.json). Country prefixes are omitted, since they are inferred from the `country` field
    Region? region?;
    # The postal code for the associated address. Between 2 and 10 alphanumeric characters. For US-based addresses this must be 5 numeric digits
    PostalCode? postal_code?;
    # Valid, capitalized, two-letter ISO code representing the country of this object. Must be in ISO 3166-1 alpha-2 form
    GenericCountryCode country;
};

# Defines the request schema for `/transfer/capabilities/get`
public type TransferCapabilitiesGetRequest record {
    # The Plaid `access_token` for the account that will be debited or credited
    @jsondata:Name {value: "access_token"}
    TransferAccessToken accessToken;
    # The Plaid `account_id` corresponding to the end-user account that will be debited or credited
    @jsondata:Name {value: "account_id"}
    TransferAccountID accountId;
    # A payment profile token associated with the Payment Profile data that is being requested
    @jsondata:Name {value: "payment_profile_token"}
    PaymentProfileToken paymentProfileToken?;
    # Your Plaid API `secret`. The `secret` is required and may be provided either in the `PLAID-SECRET` header or as part of a request body
    APISecret secret?;
    # Your Plaid API `client_id`. The `client_id` is required and may be provided either in the `PLAID-CLIENT-ID` header or as part of a request body
    @jsondata:Name {value: "client_id"}
    APIClientID clientId?;
};

# Request schema for `/beta/partner/customer/v1/get`
public type BetaPartnerCustomerV1GetRequest record {
    # Your Plaid API `client_id`. The `client_id` is required and may be provided either in the `PLAID-CLIENT-ID` header or as part of a request body
    APIClientID client_id?;
    # Your Plaid API `secret`. The `secret` is required and may be provided either in the `PLAID-SECRET` header or as part of a request body
    APISecret secret?;
