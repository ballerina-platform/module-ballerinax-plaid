public type SandboxIncomeWebhookFireRequestWebhookCode "INCOME_VERIFICATION"|"USER_INCOME_VERIFICATION"|"INCOME_VERIFICATION_RISK_SIGNALS"|"USER_INCOME_VERIFICATION_RISK_SIGNALS";

# The pay frequency of a specified income source
public type UserStatedIncomeSourceFrequency "UNKNOWN"|"WEEKLY"|"BIWEEKLY"|"SEMI_MONTHLY"|"MONTHLY";

# An institution object. If the Item was created via Same-Day or Instant micro-deposit verification, will be `null`
