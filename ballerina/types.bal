    string end_customer_client_id;
};

# Field containing the data used in determining the outcome of the synthetic identity risk check.
# 
# Contains the following fields:
# 
# `score` - A score from 0 to 100 indicating the likelihood that the user is a synthetic identity
public type RiskCheckSyntheticIdentity record {
    # A score from 0 to 100 indicating the likelihood that the user is a synthetic identity.
    int score;
    # Risk level for the given risk check type
    RiskLevel risk_level?;
    # Field containing the data used in determining the outcome of a synthetic fraud risk check
    SyntheticFraud? first_party_synthetic_fraud?;
    # Field containing the data used in determining the outcome of a synthetic fraud risk check
    SyntheticFraud? third_party_synthetic_fraud?;
};

# WHOIS metadata for the business website domain
public type BusinessWhoisRecord record {
    # An ISO8601 formatted timestamp
    TimestampNullable? domain_created_at;
    # An ISO8601 formatted timestamp
    TimestampNullable? domain_updated_at;
    # An ISO8601 formatted timestamp
    TimestampNullable? domain_expires_at;
    # Domain registrar.
    string? registrar;
};

# Details about a fixed income security's expected rate of return
public type YieldRate record {
    # The fixed income security's expected rate of return.
    decimal percentage;
    # The type of rate which indicates how the predicted yield was calculated. It is one of:
    # 
    # `coupon`: the annualized interest rate for securities with a one-year term or longer, such as treasury notes and bonds.
    # 
    # `coupon_equivalent`: the calculated equivalent for the annualized interest rate factoring in the discount rate and time to maturity, for shorter term, non-interest-bearing securities such as treasury bills.
    # 
    # `discount`: the rate at which the present value or cost is discounted from the future value upon maturity, also known as the face value.
    # 
    # `yield`: the total predicted rate of return factoring in both the discount rate and the coupon rate, applicable to securities such as exchange-traded bonds which can both be interest-bearing as well as sold at a discount off their face value
    YieldRateType? 'type;
};

# Metadata of the income stream's next payment
public type CraIncomeNextPayment record {
    # The expected date of the income stream's next payment. The date will be returned in an ISO 8601 format (YYYY-MM-DD).
    string date;
};

# The legal structure or type of business entity
public type BusinessEntityType "sole_proprietorship"|"general_partnership"|"llc"|"llp"|"lllp"|"lp"|"c_corporation"|"s_corporation"|"b_corporation"|"nonprofit"|"cooperative"|"trust"|"professional_association"|"professional_corporation"|"trade_name"|"bank"|"credit_union"|"insurance"|"other"|"unknown"?;

# The amount and currency of a payment
public type PaymentAmountNullable record {
