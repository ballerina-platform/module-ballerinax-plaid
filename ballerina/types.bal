    PartyIndividual INDIVIDUAL;
    # Documentation not found in the MISMO model viewer and not provided by Freddie Mac
    Roles ROLES;
    # The collection of `TAXPAYER_IDENTIFICATION` elements
    TaxpayerIdentifiers TAXPAYER_IDENTIFIERS;
};

