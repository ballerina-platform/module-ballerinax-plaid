# A single CRA servicing subscription
public type CraServicingSubscription record {
    # A CRA servicing subscription identifier, in the format `cra-sub-<environment>-<uuid>`
    CraSubscriptionID subscription_id;
    # A unique user identifier, created by `/user/create`. Integrations that began using `/user/create` after December 10, 2025 use this field to identify a user instead of the `user_token`. For more details, see [New User APIs](https://plaid.com/docs/api/users/user-apis)
    NewUserID user_id;
    # Determines whose items are used. `PLAID_NETWORK` (default) uses the Plaid Network view of the user's profile. `CLIENT_USER` uses only the items linked by this client
    CraReportScope scope;
    # The cadence at which products are generated and webhooks are fired. If the Qualify product is requested, cadence must be null or omitted, because Qualify's generation cadence is controlled by Plaid
    CraSubscriptionCadence? cadence?;
    # The webhook URL Plaid sends report-update notifications to for this subscription, or null if none is set.
    string? webhook?;
    # The products this subscription covers, each with the options it is configured with.
    CraSubscriptionProductConfig[] products;
};

# Information about the last change made to the parent object specifying what caused the change as well as when it occurred
public type WatchlistScreeningAuditTrail record {
    # A type indicating who or what last touched this object. `dashboard`, `link`, and `api` indicate the originating surface; `system` indicates Plaid. `retro` indicates a screening created retroactively via a bulk screening creation
    Source 'source;
    # ID of the associated user. To retrieve the email address or other details of the person corresponding to this ID, use `/dashboard_user/get`
    DashboardUserIDNullable? dashboard_user_id;
    # An ISO8601 formatted timestamp
    Timestamp timestamp;
};

# A review submitted by a team member for an entity watchlist screening. A review can be either a comment on the current screening state, actions taken
# against hits attached to the watchlist screening, or both
public type EntityWatchlistScreeningReview record {
    # ID of the associated entity review
    EntityWatchlistScreeningReviewID id;
    # Hits marked as a true positive after thorough manual review. These hits will never recur or be updated once confirmed. In most cases, confirmed hits indicate that the customer should be rejected.
    EntityWatchlistScreeningHitID[] confirmed_hits;
    # Hits marked as a false positive after thorough manual review. These hits will never recur or be updated once dismissed.
    EntityWatchlistScreeningHitID[] dismissed_hits;
    # A comment submitted by a team member as part of reviewing a watchlist screening
    ReviewComment? comment;
    # Information about the last change made to the parent object specifying what caused the change as well as when it occurred
    WatchlistScreeningAuditTrail audit_trail;
};

