    int? daysWithTxOver6Months?;
    # Total number of days with a negative balance over the past 6 months
    @jsondata:Name {value: "tot_number_days_with_negative_balance_over_6_months"}
    int? totNumberDaysWithNegativeBalanceOver6Months?;
    # Average daily balance over the past 3 months
    @jsondata:Name {value: "avg_daily_balance_over_3_months"}
    decimal? avgDailyBalanceOver3Months?;
    # Total number of days with a negative balance over the past 12 months
    @jsondata:Name {value: "tot_number_days_with_negative_balance_over_12_months"}
    int? totNumberDaysWithNegativeBalanceOver12Months?;
    # Total number of days with a negative balance over the past 3 months
    @jsondata:Name {value: "tot_number_days_with_negative_balance_over_3_months"}
    int? totNumberDaysWithNegativeBalanceOver3Months?;
    # Number of checking accounts included in the report
    @jsondata:Name {value: "num_checking_accounts"}
    int? numCheckingAccounts?;
    # Number of savings accounts included in the report
    @jsondata:Name {value: "num_savings_accounts"}
    int? numSavingsAccounts?;
    # Average daily balance over the past 1 month
    @jsondata:Name {value: "avg_daily_balance_over_1_month"}
    decimal? avgDailyBalanceOver1Month?;
    # Average daily balance over the past 6 months
    @jsondata:Name {value: "avg_daily_balance_over_6_months"}
    decimal? avgDailyBalanceOver6Months?;
    # Number of days with at least one transaction over the past 12 months
    @jsondata:Name {value: "days_with_tx_over_12_months"}
    int? daysWithTxOver12Months?;
    # Sum of current balances across all accounts in the report
    @jsondata:Name {value: "tot_current_balances"}
    decimal? totCurrentBalances?;
    # Number of money market accounts included in the report
    @jsondata:Name {value: "num_money_market_accounts"}
    int? numMoneyMarketAccounts?;
    # Number of days since the most recent day with a negative ending balance
    @jsondata:Name {value: "days_since_most_recent_negative_ending_balance"}
    int? daysSinceMostRecentNegativeEndingBalance?;
    # Number of days with at least one transaction over the past 3 months
    @jsondata:Name {value: "days_with_tx_over_3_months"}
    int? daysWithTxOver3Months?;
    # Total number of days with a negative balance over the past 1 month
    @jsondata:Name {value: "tot_number_days_with_negative_balance_over_1_month"}
    int? totNumberDaysWithNegativeBalanceOver1Month?;
    # Number of days since the most recent transaction
    @jsondata:Name {value: "days_since_most_recent_tx"}
    int? daysSinceMostRecentTx?;
    # Number of days since the most recent insufficient funds fee debit transaction
    @jsondata:Name {value: "days_since_most_recent_insufficient_funds_fee_debit_tx"}
    int? daysSinceMostRecentInsufficientFundsFeeDebitTx?;
    # Average daily balance over the past 12 months
    @jsondata:Name {value: "avg_daily_balance_over_12_months"}
    decimal? avgDailyBalanceOver12Months?;
    # Total number of accounts included in the report. Limited to checking, savings, and money market accounts
    @jsondata:Name {value: "num_accounts"}
    int? numAccounts?;
    # Number of days with at least one transaction over the past 1 month
    @jsondata:Name {value: "days_with_tx_over_1_month"}
    int? daysWithTxOver1Month?;
};

