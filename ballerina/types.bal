    @jsondata:Name {value: "bank_employment_results"}
    CreditSessionBankEmploymentResult[] bankEmploymentResults?;
    # The set of bank income verifications for the Link session
    @jsondata:Name {value: "bank_income_results"}
    CreditSessionBankIncomeResult[] bankIncomeResults?;
