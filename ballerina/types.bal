    string start_date;
    # The end date of the incident, in [ISO 8601](https://wikipedia.org/wiki/ISO_8601) format, e.g. `"2020-10-30T15:26:48Z"`.
    string? end_date?;
    # The title of the incident
    string title;
    # Updates on the health incident.
    IncidentUpdate[] incident_updates;
};

