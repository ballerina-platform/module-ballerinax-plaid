    PlaidLendScoreVersion? lendScoreVersion?;
};

# Request to seed an FDX consent grant, and its backing item, for the given end user and recipient application so the FDX Consent API can be exercised in Sandbox
public type SandboxFdxConsentSeedRequest record {
    # Your Plaid API `secret`. The `secret` is required and may be provided either in the `PLAID-SECRET` header or as part of a request body
    APISecret secret?;
    # The data provider's identifier for the end user to associate the seeded consent grant with
    @jsondata:Name {value: "customer_id"}
    string customerId;
    # This field will map to the application ID that is returned from `/item/application/list`, or provided to the institution in an oauth redirect
    @jsondata:Name {value: "application_id"}
    ApplicationID applicationId;
    # Your Plaid API `client_id`. The `client_id` is required and may be provided either in the `PLAID-CLIENT-ID` header or as part of a request body
    @jsondata:Name {value: "client_id"}
    APIClientID clientId?;
    # Optional UUIDv4 identifier for the seeded consent grant. If omitted, one is generated. Seeding fails if a grant with this identifier already exists
    @jsondata:Name {value: "consent_id"}
    string consentId?;
};

# Defines the request schema for `/sandbox/transfer/refund/simulate`
public type SandboxTransferRefundSimulateRequest record {
    # The asynchronous event to be simulated. May be: `refund.posted`, `refund.settled`, `refund.failed`, or `refund.returned`.
    # 
    # An error will be returned if the event type is incompatible with the current refund status. Compatible status --> event type transitions include:
    # 
    # `refund.pending` --> `refund.failed`
    # 
    # `refund.pending` --> `refund.posted`
    # 
    # `refund.posted` --> `refund.returned`
    # 
    # `refund.posted` --> `refund.settled`
    # 
    # `refund.posted` events can only be simulated if the refunded transfer has been transitioned to settled. This mimics the ordering of events in Production
    @jsondata:Name {value: "event_type"}
    string eventType;
    # The webhook URL to which a `TRANSFER_EVENTS_UPDATE` webhook should be sent
    string webhook?;
    # Your Plaid API `secret`. The `secret` is required and may be provided either in the `PLAID-SECRET` header or as part of a request body
    APISecret secret?;
    # Plaid's unique identifier for a test clock. If provided, the event to be simulated is created at the `virtual_time` on the provided `test_clock`
    @jsondata:Name {value: "test_clock_id"}
    string? testClockId?;
    # The failure reason if the event type for a transfer is `"failed"` or `"returned"`. Null value otherwise
    @jsondata:Name {value: "failure_reason"}
    TransferFailure? failureReason?;
    # Plaid's unique identifier for a refund
    @jsondata:Name {value: "refund_id"}
    TransferRefundID refundId;
    # Your Plaid API `client_id`. The `client_id` is required and may be provided either in the `PLAID-CLIENT-ID` header or as part of a request body
    @jsondata:Name {value: "client_id"}
    APIClientID clientId?;
};

