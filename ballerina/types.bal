# Object with data pertaining to an amount on the transaction stream
public type TransactionStreamAmount record {
    # Represents the numerical value of an amount.
    decimal amount?;
    # The ISO-4217 currency code of the amount. Always `null` if `unofficial_currency_code` is non-`null`.
    # 
    # See the [currency code schema](https://plaid.com/docs/api/accounts#currency-code-schema) for a full listing of supported `iso_currency_code`s.
    string? iso_currency_code?;
    # The unofficial currency code of the amount. Always `null` if `iso_currency_code` is non-`null`. Unofficial currency codes are used for currencies that do not have official ISO currency codes, such as cryptocurrencies and the currencies of certain countries.
    string? unofficial_currency_code?;
};

# Event data for Protect events
public type ProtectEvent record {
    # The timestamp of the event, in [ISO 8601](https://wikipedia.org/wiki/ISO_8601) format, e.g. `"2017-09-14T14:42:19.350Z"`
    string timestamp;
    # If present, contains the current Device Session ID from the Protect SDK.
    string device_session_id?;
    # This event type represents a user visiting the client application
    ProtectAppVisitEvent? app_visit?;
    # This event type represents a user signing in to the application
    ProtectUserSignInEvent? user_sign_in?;
    # This event type represents a user signing up for the application
    ProtectUserSignUpEvent? user_sign_up?;
};

# Indicates the account's categorization as either a personal or a business account. This field is currently in beta; to request access, contact your account manager. Coverage varies by institution, with approximately 70% of accounts populated overall
